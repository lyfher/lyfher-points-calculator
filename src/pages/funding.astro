// Score an opportunity: high APR, cheap entry (negative spread = free), penalize slow recovery
function scoreRow(r){
  const sp=r.spread==null?0.1:r.spread;
  const entryCost=Math.max(sp,0);                       // negative spread costs nothing to enter
  const daysToRecover=r.netAPR>0?entryCost/(r.netAPR/365):999;
  return r.netAPR - daysToRecover*2;
}
function dexUrl(ex, coin){ const m=EX[ex]||{}; return m.trade&&coin ? m.trade.replace('{c}', coin) : (m.ref||''); }
function openBtn(l, coin){ const m=EX[l.ex]||{}; const u=dexUrl(l.ex, coin); return u?`<a href="${u}" target="_blank" rel="noopener noreferrer" class="text-center px-3 py-1.5 rounded-lg border text-xs font-semibold whitespace-nowrap" style="color:${m.color};border-color:${m.color}55;background:${m.color}14">${T('Open','Abrir')} ${m.short} ↗</a>`:''; }
