function tradeMath(r){
  const cap=capital(); if(!cap) return '';
  const yr=r.netAPR/100*cap, daily=yr/365, sp=r.spread;
  let entryLine, beLine='';
  if(sp==null){ entryLine = r.spreadNote==='mismatch'
      ? T('Entry spread: venues price this >25% apart — likely different contracts, skip.','Spread de entrada: los venues lo valoran con >25% de diferencia — probablemente contratos distintos, evítalo.')
      : T('Entry spread: no price feed.','Spread de entrada: sin precio.'); }
  else {
    const entry=sp/100*cap;  // + = cost, − = credit
    if(sp<0){
      entryLine=`<span class="text-green-400">${T('Entry spread','Spread de entrada')} ${sp.toFixed(3)}% = +${fmtMoney(-entry)} ${T('credit','de crédito')}</span>`;
      beLine=T('You start ahead — funding is profit from day 1.','Empiezas ganando — el funding es ganancia desde el día 1.');
    } else {
      entryLine=`<span class="text-yellow-400">${T('Entry spread','Spread de entrada')} ${sp.toFixed(3)}% = −${fmtMoney(entry)} ${T('cost','de costo')}</span>`;
      const days=daily>0?entry/daily:Infinity;
      beLine=isFinite(days)?T(`Break-even in ~${days.toFixed(1)} days of funding.`,`Recuperas en ~${days.toFixed(1)} días de funding.`):T('Funding too low to recover the entry.','Funding muy bajo para recuperar la entrada.');
    }
  }
  return `<div class="mt-2 pt-2 border-t border-gray-800">
    <div class="text-gray-500 mb-1">${T('Trade math on','Cálculo sobre')} ${fmtMoney(cap)} ${T('per leg','por pata')}</div>
    <div>${entryLine}</div>
    <div class="text-emerald-400">${T('Funding','Funding')}: +${fmtMoney(yr)}/yr · +${fmtMoney(daily)}/${T('day','día')}</div>
    ${beLine?`<div class="text-gray-400">${beLine}</div>`:''}
  </div>`;
}
function buildDetail(r){
