    ${legLine(r.long,'long',r.coin)}
    ${legLine(r.short,'short',r.coin)}
    ${(() => { const btn=(l)=>{ const m=EX[l.ex]||{}; const u=dexUrl(l.ex, r.coin); return u?`<a href="${u}" target="_blank" rel="noopener noreferrer" class="inline-block px-2.5 py-1 rounded border font-semibold" style="color:${m.color};border-color:${m.color}55;background:${m.color}14">${T('Open','Abrir')} ${m.short} ↗</a>`:''; };
      const b=[btn(r.long),btn(r.short)].filter(Boolean).join(' '); return b?`<div class="mt-2 flex gap-2">${b}</div>`:''; })()}
    ${(depthWarn?`<div class="mt-2 text-red-400">⚠ ${T('Thin market ('+fmtMoney(r.depth)+' OI) — hard to size in, slippage is high.','Mercado fino ('+fmtMoney(r.depth)+' OI) — difícil entrar, slippage alto.')}</div>`:'')}
    ${tradeMath(r)}
    ${(() => { const h=histStats(r.coin);
      if(!h||h.n<MIN_HIST) return `<div class="mt-2 pt-2 border-t border-gray-800 text-gray-500">${T('Net APR history: building','Historial de APR neto: creando')} ${h?h.n:0}/${MIN_HIST} ${T('snapshots — consistency shown once ~a day of data is in.','snapshots — la consistencia se muestra al tener ~un día de datos.')}</div>`;
      const lbl={high:T('High','Alta'),med:T('Medium','Media'),low:T('Low','Baja')}[h.cons];
      const col={high:'text-green-400',med:'text-yellow-400',low:'text-red-400'}[h.cons];
      return `<div class="mt-2 pt-2 border-t border-gray-800">
        <div class="text-gray-500 mb-1">${T('Net APR history (all DEXs)','Historial de APR neto (todos los DEXs)')}</div>
        <div>24h: <span class="font-mono text-gray-200">${h.avg24!=null?(h.avg24>=0?'+':'')+h.avg24.toFixed(1)+'%':'—'}</span> · 7d: <span class="font-mono text-gray-200">${h.avg7>=0?'+':''}${h.avg7.toFixed(1)}%</span> · ${T('consistency','consistencia')}: <span class="${col} font-semibold">${lbl}</span> <span class="text-gray-600">(${h.n} ${T('samples','muestras')})</span></div>
      </div>`; })()}
    ${(() => { const sp=spreadStats(r.coin); if(!sp) return '';
      const tl={converging:T('converging ↓','convergiendo ↓'),widening:T('widening ↑','ampliándose ↑'),stable:T('stable →','estable →')}[sp.trend];
      const tc={converging:'text-green-400',widening:'text-red-400',stable:'text-gray-400'}[sp.trend];
      const building=sp.n<MIN_HIST?` <span class="text-gray-600">(${T('building','creando')} ${sp.n}/${MIN_HIST})</span>`:'';
      return `<div class="mt-2 pt-2 border-t border-gray-800">
        <div class="text-gray-500 mb-1">${T('Entry-spread history','Historial de spread de entrada')}</div>
        <div>24h: <span class="font-mono text-gray-200">${(sp.avg24>=0?'+':'')+sp.avg24.toFixed(2)}%</span> · 7d: <span class="font-mono text-gray-200">${(sp.avg7>=0?'+':'')+sp.avg7.toFixed(2)}%</span> · <span class="${tc} font-semibold">${tl}</span>${building}</div>
        <div class="text-gray-600 mt-0.5">${T('Converging = the price gap is shrinking, so the entry cost tends to be recovered.','Convergiendo = la brecha de precio se achica, el costo de entrada tiende a recuperarse.')}</div>
      </div>`; })()}
  </div>`;
}

function tipHtml(r){
  const l=(EX[r.long.ex]||{}).short, s=(EX[r.short.ex]||{}).short;
  const sp=r.spread;
  let spLine;
  if(sp==null) spLine = r.spreadNote==='mismatch'
    ? T('Entry: venues price this >25% apart — likely different contracts.','Entrada: los venues lo valoran con >25% de diferencia — probablemente contratos distintos.')
    : T('Entry: no price feed to check.','Entrada: sin precio para verificar.');
  else if(sp<0) spLine=T(`Entry pays you ${Math.abs(sp).toFixed(2)}% — you open at a credit, then farm funding.`,`La entrada te paga ${Math.abs(sp).toFixed(2)}% — abres con crédito y farmeas.`);
  else if(sp<=0.05) spLine=T('Cheap entry — start flat, farm the funding.','Entrada barata — empiezas a la par y farmeas.');
  else spLine=T(`Entry costs ${sp.toFixed(2)}% — recovered by funding if it holds.`,`Entrada cuesta ${sp.toFixed(2)}% — se recupera con el funding si se mantiene.`);
  const cap=capital(), yr=r.netAPR/100*cap, dy=yr/365;
