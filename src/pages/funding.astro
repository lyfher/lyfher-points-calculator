---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Lyfher — Delta-Neutral Funding Scanner" description="Live funding rates across decentralized perp DEXs to spot delta-neutral farming opportunities and capture the spread.">

<!-- Hero -->
<section class="text-center py-8">
  <h1 class="text-4xl sm:text-5xl font-bold text-white mb-3">
    <span data-en="Delta-Neutral" data-es="Delta-Neutral">Delta-Neutral</span>
    <span class="text-green-400"> Scanner</span>
  </h1>
  <p class="text-gray-400 text-base max-w-2xl mx-auto"
     data-en="Live funding across decentralized perp DEXs. Long where they pay you, short where you pay, stay neutral to price and farm the funding spread — filtered for real depth."
     data-es="Funding en vivo en perp DEXs descentralizados. Ve largo donde te pagan, corto donde pagas, mantente neutral al precio y farmea el spread — filtrado por profundidad real.">
    Live funding across decentralized perp DEXs — filtered for real depth.
  </p>
</section>

<!-- Stats -->
<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
  <div class="bg-gray-900 border border-gray-800 rounded-xl p-3 text-center">
    <div id="stat-ops" class="text-2xl font-bold text-green-400">—</div>
    <div class="text-xs text-gray-500 mt-0.5" data-en="Opportunities" data-es="Oportunidades">Opportunities</div>
  </div>
  <div class="bg-gray-900 border border-gray-800 rounded-xl p-3 text-center">
    <div id="stat-best" class="text-2xl font-bold text-emerald-400">—</div>
    <div class="text-xs text-gray-500 mt-0.5" data-en="Best net APR" data-es="Mejor APR neto">Best net APR</div>
  </div>
  <div class="bg-gray-900 border border-gray-800 rounded-xl p-3 text-center">
    <div id="stat-sources" class="text-2xl font-bold text-blue-400">—</div>
    <div class="text-xs text-gray-500 mt-0.5" data-en="Exchanges live" data-es="Exchanges activos">Exchanges live</div>
  </div>
  <div id="autorefresh-toggle" class="bg-gray-900 border border-gray-800 rounded-xl p-3 text-center cursor-pointer select-none">
    <div id="stat-refresh" class="text-2xl font-bold text-yellow-400">60s</div>
    <div class="text-xs text-gray-500 mt-0.5" data-en="Auto-refresh" data-es="Auto-actualizar">Auto-refresh</div>
  </div>
</div>

<!-- Scanner header -->
<div class="flex items-center gap-2 mb-3">
  <span class="text-lg">🔬</span>
  <h2 class="text-lg font-bold text-white" data-en="Live Scanner" data-es="Scanner en Vivo">Live Scanner</h2>
</div>

<!-- Controls -->
<div class="flex items-center justify-between mb-4 gap-3 flex-wrap">
  <div class="flex items-center gap-2 flex-1 min-w-40">
    <input id="search" type="text" placeholder="BTC, ETH, SOL…"
           data-placeholder-en="BTC, ETH, SOL…" data-placeholder-es="BTC, ETH, SOL…"
           class="flex-1 bg-gray-900 border border-gray-700 text-white text-sm rounded-lg px-3 py-1.5 focus:outline-none focus:border-green-500"/>
  </div>
  <div class="flex items-center gap-2">
    <label class="text-xs text-gray-500" data-en="Min depth" data-es="Profundidad mín">Min depth</label>
    <select id="min-depth" class="bg-gray-900 border border-gray-700 text-white text-xs rounded-lg px-2 py-1.5 focus:outline-none focus:border-green-500">
      <option value="0">All</option>
      <option value="100000">$100K</option>
      <option value="500000">$500K</option>
      <option value="1000000" selected>$1M</option>
      <option value="5000000">$5M</option>
      <option value="10000000">$10M</option>
    </select>
    <label class="text-xs text-gray-500" data-en="Max spread" data-es="Spread máx">Max spread</label>
    <select id="max-spread" class="bg-gray-900 border border-gray-700 text-white text-xs rounded-lg px-2 py-1.5 focus:outline-none focus:border-green-500">
      <option value="0.5">0.5%</option>
      <option value="1" selected>1%</option>
      <option value="2">2%</option>
      <option value="999">All</option>
    </select>
    <label class="text-xs text-gray-500" data-en="Min APR" data-es="APR mín">Min APR</label>
    <select id="min-apr" class="bg-gray-900 border border-gray-700 text-white text-xs rounded-lg px-2 py-1.5 focus:outline-none focus:border-green-500">
      <option value="0" selected>All</option>
      <option value="5">5%</option>
      <option value="10">10%</option>
      <option value="20">20%</option>
      <option value="50">50%</option>
      <option value="100">100%</option>
    </select>
  </div>
</div>

<!-- DEX filter chips -->
<div class="flex items-center gap-2 flex-wrap mb-4">
  <span class="text-xs text-gray-500 mr-1" data-en="DEXs:" data-es="DEXs:">DEXs:</span>
  <div id="dex-filter" class="flex flex-wrap gap-1.5"></div>
  <button id="dex-all" class="text-xs text-gray-500 hover:text-white underline ml-1" data-en="all" data-es="todos">all</button>
  <button id="dex-none" class="text-xs text-gray-500 hover:text-white underline" data-en="none" data-es="ninguno">none</button>
</div>
<div class="flex items-center gap-2 mb-4">
  <div id="status-dot" class="w-2.5 h-2.5 rounded-full bg-yellow-500 animate-pulse shrink-0"></div>
  <span id="status-text" class="text-sm text-gray-500">Loading…</span>
  <button id="refresh-btn" class="ml-auto flex items-center gap-2 bg-gray-900 border border-gray-700 hover:border-green-500 text-white text-sm font-medium px-4 py-1.5 rounded-lg transition-colors">
    <span id="refresh-icon" class="inline-block">↻</span>
    <span data-en="Refresh" data-es="Actualizar">Refresh</span>
  </button>
</div>

<!-- Table -->
<div class="bg-gray-900 border border-gray-800 rounded-2xl overflow-hidden mb-6">
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-gray-800 text-xs text-gray-500 uppercase">
          <th class="text-left px-4 py-3" data-en="Symbol" data-es="Símbolo">Symbol</th>
          <th class="text-center px-3 py-3" data-en="Best Pair (Long / Short)" data-es="Mejor Par (Long / Short)">Best Pair (Long / Short)</th>
          <th class="sortable text-right px-3 py-3 cursor-pointer hover:text-white select-none" data-sort="net">
            <span data-en="Net APR" data-es="APR Neto">Net APR</span> <span class="sort-arrow" data-key="net"></span>
          </th>
          <th class="sortable text-right px-3 py-3 cursor-pointer hover:text-white select-none" data-sort="spread">
            <span data-en="Entry Spread" data-es="Spread Entrada">Entry Spread</span> <span class="sort-arrow" data-key="spread"></span>
          </th>
          <th class="sortable text-right px-4 py-3 cursor-pointer hover:text-white select-none" data-sort="depth">
            <span data-en="Depth" data-es="Profundidad">Depth</span> <span class="sort-arrow" data-key="depth"></span>
          </th>
        </tr>
      </thead>
      <tbody id="table-body">
        <tr><td colspan="5" class="text-center py-16 text-gray-600" data-en="Loading funding data…" data-es="Cargando datos de funding…">Loading funding data…</td></tr>
      </tbody>
    </table>
  </div>
</div>

<!-- Guide -->
<div class="bg-gray-900/60 border border-gray-800 rounded-2xl p-5 mb-6">
  <h2 class="text-base font-bold text-white mb-4" data-en="How delta-neutral farming works" data-es="Cómo funciona el farming delta-neutral">How delta-neutral farming works</h2>
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <h3 class="text-sm font-semibold text-green-400 mb-1" data-en="1. Open both legs" data-es="1. Abre ambas patas">1. Open both legs</h3>
      <p class="text-xs text-gray-500 leading-relaxed"
         data-en="Long the exchange with the lowest (most negative) funding and short the one with the highest. Equal notional on both — you're neutral to price."
         data-es="Ve largo en el exchange con funding más bajo (más negativo) y corto en el más alto. Mismo nocional en ambos — quedas neutral al precio.">
        Long the lowest funding, short the highest. Equal notional — neutral to price.
      </p>
    </div>
    <div>
      <h3 class="text-sm font-semibold text-green-400 mb-1" data-en="2. Collect the spread" data-es="2. Cobra el spread">2. Collect the spread</h3>
      <p class="text-xs text-gray-500 leading-relaxed"
         data-en="Funding pays every 1–8h depending on the exchange. The short receives when funding is positive; the long receives when negative. You pocket the difference (Net APR)."
         data-es="El funding se paga cada 1–8h según el exchange. El corto cobra cuando el funding es positivo; el largo cobra cuando es negativo. Te quedas con la diferencia (APR Neto).">
        Funding pays every 1–8h. You pocket the difference (Net APR).
      </p>
    </div>
    <div>
      <h3 class="text-sm font-semibold text-yellow-400 mb-1" data-en="3. Entry spread & rebalancing" data-es="3. Spread de entrada y rebalanceo">3. Entry spread & rebalancing</h3>
      <p class="text-xs text-gray-500 leading-relaxed"
         data-en="The price spread is your entry cost, not profit. Small/negative = cheap entry. If it widens after you enter, one leg shows unrealized loss (offset by the other) and stresses margin — rebalance or wait for it to converge."
         data-es="El spread de precio es tu costo de entrada, no ganancia. Pequeño/negativo = entrada barata. Si se ensancha después de entrar, una pata queda en pérdida no realizada (compensada por la otra) y estresa el margen — rebalancea o espera a que converja.">
        Price spread = entry cost. If it widens, rebalance or wait for convergence.
      </p>
    </div>
    <div>
      <h3 class="text-sm font-semibold text-red-400 mb-1" data-en="4. Depth & risks" data-es="4. Profundidad y riesgos">4. Depth & risks</h3>
      <p class="text-xs text-gray-500 leading-relaxed"
         data-en="Juicy funding on a thin market is a trap — you can't size in without moving price and funding normalizes fast. Filter by depth. Funding flips, fees and slippage eat profit. New exchanges carry counterparty risk."
         data-es="Un funding jugoso en un mercado fino es una trampa — no puedes entrar sin mover el precio y el funding se normaliza rápido. Filtra por profundidad. Los flips de funding, fees y slippage reducen la ganancia. Los exchanges nuevos tienen riesgo de contraparte.">
        Thin markets are traps. Filter by depth. Fees, flips and slippage eat profit.
      </p>
    </div>
  </div>
</div>

<section class="mt-4 border-t border-gray-800 pt-6 text-center">
  <p class="text-gray-600 text-sm max-w-xl mx-auto"
     data-en="Funding rates are normalized to annualized APR (as shown on each exchange) and are before fees & slippage. Not financial advice — always verify on the exchange."
     data-es="Las tasas de funding se normalizan a APR anualizado (como se muestran en cada exchange) y son antes de fees y slippage. No es asesoría financiera — verifica siempre en el exchange.">
    Funding rates are normalized to annualized APR, before fees & slippage.
  </p>
</section>

<!-- Tooltip -->
<div id="tip" class="hidden fixed z-[100] max-w-xs bg-gray-950 border border-gray-700 rounded-xl p-3 text-xs text-gray-300 shadow-2xl pointer-events-none leading-relaxed"></div>

</Layout>

<script is:inline>
const REFRESH_MS = 60000;
let rows = [], timer = null, autoOn = true, cd = 60;
let sortKey = 'net', sortDir = -1;
let enabledEx = null;   // Set of enabled exchange keys (null = all until built)
const $ = id => document.getElementById(id);
const lang = () => document.documentElement.lang || 'en';
const T = (en, es) => lang() === 'es' ? es : en;

// ─── Exchange metadata ──────────────────────────────────────────────────
// tier: A = established/deep, B = growing, C = new/beta
const EX = {
  Hyperliquid:{ short:'Hyperliquid', color:'#60a5fa', tier:'A', interval:'1h', ref:'' },
  Lighter:    { short:'Lighter',     color:'#a3e635', tier:'A', interval:'1h', ref:'' },
  Extended:   { short:'Extended',    color:'#34d399', tier:'B', interval:'1h', ref:'https://app.extended.exchange/join/LYFHER' },
  Pacifica:   { short:'Pacifica',    color:'#22d3ee', tier:'B', interval:'1h', ref:'https://app.pacifica.fi?referral=Lyfher' },
  Variational:{ short:'Variational', color:'#a78bfa', tier:'B', interval:'1h', ref:'' },
  Arcus:      { short:'Arcus',       color:'#f472b6', tier:'C', interval:'1h', ref:'' },
  RiseX:      { short:'RiseX',       color:'#e879f9', tier:'C', interval:'8h', ref:'' },
  TxFlow:     { short:'TxFlow',      color:'#4ade80', tier:'C', interval:'1h', ref:'' },
};
const isEst = name => EX[name] && EX[name].tier === 'A';

// ─── Helpers ────────────────────────────────────────────────────────────
function setStatus(s){
  const t={loading:{en:'Loading…',es:'Cargando…'},live:{en:'Up to date',es:'Actualizado'},error:{en:'Error',es:'Error'}};
  const c={loading:'bg-yellow-500 animate-pulse',live:'bg-green-500',error:'bg-red-500'};
  $('status-dot').className=`w-2.5 h-2.5 rounded-full ${c[s]} shrink-0`;
  $('status-text').textContent=t[s][lang()]||t[s].en;
}
function fmtMoney(n){
  if(n==null) return '—';
  if(n>=1e9) return '$'+(n/1e9).toFixed(2)+'B';
  if(n>=1e6) return '$'+(n/1e6).toFixed(1)+'M';
  if(n>=1e3) return '$'+(n/1e3).toFixed(0)+'K';
  return '$'+n.toFixed(0);
}
function normCoin(sym){
  return sym.replace(/[-_/].*$/,'').replace(/USDT$|USDC$|USD$|PERP$/i,'').toUpperCase();
}


// ─── Sources (client, CORS-open) ────────────────────────────────────────
async function fetchHL(){
  const r=await fetch('https://api.hyperliquid.xyz/info',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({type:'metaAndAssetCtxs'})});
  if(!r.ok) throw 0; const [meta,ctxs]=await r.json(); const out={};
  meta.universe.forEach((u,i)=>{ const c=ctxs[i]||{}; const f=parseFloat(c.funding); const px=parseFloat(c.markPx);
    if(!isNaN(f)) out[normCoin(u.name)]={apr:f*24*365*100,px,oiUsd:parseFloat(c.openInterest)*px||null,volUsd:parseFloat(c.dayNtlVlm)||null}; });
  return {ex:'Hyperliquid',data:out};
}
async function fetchLighter(){
  const [fr,od]=await Promise.all([
    fetch('https://mainnet.zklighter.elliot.ai/api/v1/funding-rates').then(r=>{if(!r.ok)throw 0;return r.json();}),
    fetch('https://mainnet.zklighter.elliot.ai/api/v1/orderBookDetails').then(r=>r.ok?r.json():{order_book_details:[]}).catch(()=>({order_book_details:[]})),
  ]);
  const info={};
  (od.order_book_details||[]).forEach(d=>{ const p=parseFloat(d.mark_price); const oi=parseFloat(d.open_interest);
    info[normCoin(d.symbol)]={px:isNaN(p)?null:p, oiUsd:(!isNaN(oi)&&!isNaN(p))?oi*p:null, volUsd:parseFloat(d.daily_quote_token_volume)||null}; });
  const out={};
  // Lighter's funding-rates endpoint normalizes every venue to an 8h rate → APR = f*3*365
  (fr.funding_rates||[]).forEach(x=>{ if(x.exchange!=='lighter') return; const f=parseFloat(x.rate); if(isNaN(f)) return;
    const i=info[normCoin(x.symbol)]||{}; out[normCoin(x.symbol)]={apr:f*3*365*100,px:i.px??null,oiUsd:i.oiUsd??null,volUsd:i.volUsd??null}; });
  return {ex:'Lighter',data:out};
}
async function fetchPacifica(){
  const r=await fetch('https://api.pacifica.fi/api/v1/info/prices');
  if(!r.ok) throw 0; const j=await r.json(); const out={};
  (j.data||[]).forEach(x=>{ const f=parseFloat(x.funding); const px=parseFloat(x.mark);
    if(!isNaN(f)){ const oi=parseFloat(x.open_interest); out[normCoin(x.symbol)]={apr:f*24*365*100,px,oiUsd:!isNaN(oi)?oi*px:null,volUsd:parseFloat(x.volume_24h)*px||null}; } });
  return {ex:'Pacifica',data:out};
}
async function fetchVariational(){
  const r=await fetch('https://omni-client-api.prod.ap-northeast-1.variational.io/metadata/stats');
  if(!r.ok) throw 0; const j=await r.json(); const out={};
  // Variational's funding_rate is already an annualized fraction → APR% = f*100
  (j.listings||[]).forEach(x=>{ const f=parseFloat(x.funding_rate); const px=parseFloat(x.mark_price);
    if(!isNaN(f)){ const oi=parseFloat(x.open_interest?.long_open_interest); out[normCoin(x.ticker)]={apr:f*100,px,oiUsd:!isNaN(oi)&&px?oi*px:null,volUsd:parseFloat(x.volume_24h)||null}; } });
  return {ex:'Variational',data:out};
}
async function fetchArcus(){
  const r=await fetch('https://api.arcus.xyz/v1/markets');
  if(!r.ok) throw 0; const j=await r.json(); const out={};
  (j.markets||[]).forEach(x=>{ if(x.category!=='CRYPTO'||x.status!=='ONLINE') return; const f=parseFloat(x.fundingRate); const px=parseFloat(x.markPrice);
    if(!isNaN(f)){ const oi=parseFloat(x.openInterest); out[normCoin(x.baseAsset)]={apr:f*24*365*100,px,oiUsd:!isNaN(oi)?oi*px:null,volUsd:parseFloat(x.volume24hNotional)||null}; } });
  return {ex:'Arcus',data:out};
}
// Proxy (Extended, RiseX, TxFlow — CORS-blocked, fetched server-side)
async function fetchProxy(){
  const r=await fetch('/api/funding');
  if(!r.ok) throw 0; const j=await r.json(); const res=[];
  [['Extended',j.extended],['RiseX',j.risex],['TxFlow',j.txflow]].forEach(([ex,arr])=>{
    if(!arr) return; const out={};
    arr.forEach(x=>{ if(x.apr==null) return; out[normCoin(x.coin)]={apr:x.apr,px:x.px,oiUsd:x.oiUsd,volUsd:x.volUsd}; });
    res.push({ex,data:out});
  });
  return res;
}

const CLIENT=[fetchHL,fetchLighter,fetchPacifica,fetchVariational,fetchArcus];

// ─── Build rows ─────────────────────────────────────────────────────────
function buildRows(sources){
  const coins={};
  sources.forEach(({ex,data})=>{ if(!data) return;
    for(const c in data){ if(!coins[c]) coins[c]={coin:c,byEx:{}}; coins[c].byEx[ex]=data[c]; } });
  return Object.values(coins).map(c=>({coin:c.coin, allLegs:Object.entries(c.byEx).map(([ex,d])=>({ex,...d}))}));
}

// Derive the best pair from the currently enabled DEXs only
function deriveRow(row){
  const legs=row.allLegs.filter(l=>enabledEx.has(l.ex)).sort((a,b)=>a.apr-b.apr);
  if(legs.length<2) return null;
  const long=legs[0], short=legs[legs.length-1];   // long lowest apr, short highest
  const netAPR=short.apr-long.apr;
  let spread=null;                                  // signed entry spread: long px vs short px
  if(long.px&&short.px) spread=((long.px-short.px)/short.px)*100;
  const legDepth=[long.oiUsd,short.oiUsd].filter(v=>v!=null);
  const allD=legs.map(l=>l.oiUsd).filter(v=>v!=null);
  const depth=legDepth.length?Math.min(...legDepth):(allD.length?Math.max(...allD):null);
  return {coin:row.coin, legs, long, short, netAPR, spread, depth, sources:legs.length};
}

// ─── Render ─────────────────────────────────────────────────────────────
function badge(ex,dir){
  const m=EX[ex]||{color:'#9ca3af',short:ex};
  const arrow=dir==='long'?'▲':'▼';
  return `<span class="text-xs font-semibold px-2 py-0.5 rounded border" style="color:${m.color};border-color:${m.color}55;background:${m.color}14">${arrow} ${m.short}</span>`;
}
function netColor(v){ return v>=30?'text-green-300':v>=12?'text-green-400':v>=5?'text-emerald-500':'text-gray-500'; }

function passFilters(r){
  const md=parseFloat($('min-depth').value)||0;
  // filter on the LIMITING leg's depth — a deep coin with a thin leg is still untradeable
  if(md>0 && (r.depth==null || r.depth<md)) return false;
  // wide price gap between the two legs = dislocation / illiquidity / bad feed, not a clean entry
  const ms=parseFloat($('max-spread').value)||999;
  if(r.spread!=null && Math.abs(r.spread)>ms) return false;
  const minA=parseFloat($('min-apr').value)||0;
  if(r.netAPR<minA) return false;
  return true;
}

function renderTable(){
  const q=$('search').value.trim().toUpperCase();
  let show=rows.map(deriveRow).filter(Boolean).filter(r=>(!q||r.coin.includes(q)) && passFilters(r));
  show.sort((a,b)=>{ let av,bv;
    if(sortKey==='net'){av=a.netAPR;bv=b.netAPR;}
    else if(sortKey==='spread'){av=Math.abs(a.spread??999);bv=Math.abs(b.spread??999);}
    else if(sortKey==='depth'){av=a.depth??-1;bv=b.depth??-1;}
    else{av=a.sources;bv=b.sources;}
    return (av-bv)*sortDir; });

  $('stat-ops').textContent=show.length||'0';
  $('stat-best').textContent=show.length?('+'+Math.max(...show.map(r=>r.netAPR)).toFixed(1)+'%'):'—';

  if(!show.length){
    $('table-body').innerHTML=`<tr><td colspan="5" class="text-center py-16 text-gray-600">${T('No results — loosen the filters','Sin resultados — afloja los filtros')}</td></tr>`;
    return;
  }

  window._show=show;
  $('table-body').innerHTML=show.map((r,i)=>{
    const spreadTxt=r.spread!=null?(r.spread>=0?'+':'')+r.spread.toFixed(3)+'%':'—';
    const spreadCls=r.spread==null?'text-gray-600':Math.abs(r.spread)<0.05?'text-green-400':Math.abs(r.spread)<0.2?'text-yellow-500':'text-red-400';
    return `
    <tr class="row border-b border-gray-800/60 hover:bg-gray-800/40 transition-colors cursor-pointer" data-i="${i}">
      <td class="px-4 py-3 font-bold text-white">${r.coin}</td>
      <td class="px-3 py-3">
        <div class="flex items-center justify-center gap-2">${badge(r.long.ex,'long')}<span class="text-gray-700">/</span>${badge(r.short.ex,'short')}</div>
      </td>
      <td class="px-3 py-3 text-right font-bold ${netColor(r.netAPR)}">+${r.netAPR.toFixed(2)}%</td>
      <td class="px-3 py-3 text-right font-mono ${spreadCls}">${spreadTxt}</td>
      <td class="px-4 py-3 text-right font-mono ${r.depth!=null&&r.depth<1e6?'text-red-400':'text-gray-400'}">${fmtMoney(r.depth)}</td>
    </tr>
    <tr class="detail hidden bg-gray-950/60" data-d="${i}"><td colspan="5" class="px-4 py-3"></td></tr>`;
  }).join('');

  bindRows();
  updateSortArrows();
}

function legLine(l, role){
  const m=EX[l.ex]||{color:'#9ca3af',short:l.ex,interval:'?'};
  const c=role==='long'?'text-green-400':role==='short'?'text-red-400':'text-gray-400';
  const tag=role==='long'?T('LONG','LARGO'):role==='short'?T('SHORT','CORTO'):'';
  const name=m.ref?`<a href="${m.ref}" target="_blank" rel="noopener noreferrer" class="hover:underline" style="color:${m.color}">${m.short} ↗</a>`:`<span style="color:${m.color}">${m.short}</span>`;
  return `<div class="flex items-center justify-between gap-3 py-0.5">
    <span><span style="color:${m.color}">●</span> ${name} <span class="text-gray-600">(${m.interval}${m.tier!=='A'?' · '+T('new','nuevo'):''})</span> ${tag?`<span class="${c} font-semibold">${tag}</span>`:''}</span>
    <span class="font-mono ${l.apr>=0?'text-green-400':'text-red-400'}">${l.apr>=0?'+':''}${l.apr.toFixed(1)}%</span>
  </div>`;
}

function buildDetail(r){
  const alts=[];
  for(const l of r.legs){ if(l!==r.long&&l!==r.short) alts.push(l); }
  const depthWarn=r.depth!=null&&r.depth<1e6;
  const newLeg=!isEst(r.long.ex)||!isEst(r.short.ex);
  return `<div class="text-xs">
    <div class="font-semibold text-white mb-1">${r.coin} — ${T('all exchanges (annual APR)','todos los exchanges (APR anual)')}</div>
    ${r.legs.slice().sort((a,b)=>a.apr-b.apr).map(l=>legLine(l, l===r.long?'long':l===r.short?'short':'')).join('')}
    <div class="mt-2 pt-2 border-t border-gray-800 text-gray-400">
      ${T('Best play','Mejor jugada')}: <b class="text-green-400">${T('LONG','LARGO')} ${(EX[r.long.ex]||{}).short}</b> / <b class="text-red-400">${T('SHORT','CORTO')} ${(EX[r.short.ex]||{}).short}</b> →
      <b class="text-white">+${r.netAPR.toFixed(2)}% ${T('net APR','APR neto')}</b>
    </div>
    ${(() => { const btn=(l)=>{ const m=EX[l.ex]||{}; return m.ref?`<a href="${m.ref}" target="_blank" rel="noopener noreferrer" class="inline-block px-2.5 py-1 rounded border font-semibold" style="color:${m.color};border-color:${m.color}55;background:${m.color}14">${T('Open','Abrir')} ${m.short} ↗</a>`:''; };
      const b=[btn(r.long),btn(r.short)].filter(Boolean).join(' '); return b?`<div class="mt-2 flex gap-2">${b}</div>`:''; })()}
    ${(depthWarn?`<div class="mt-1 text-red-400">⚠ ${T('Thin market ('+fmtMoney(r.depth)+' OI) — funding may not hold and slippage is high.','Mercado fino ('+fmtMoney(r.depth)+' OI) — el funding puede no sostenerse y el slippage es alto.')}</div>`:'')}
    ${(newLeg?`<div class="mt-1 text-yellow-500">⚠ ${T('Involves a newer exchange — higher counterparty risk.','Involucra un exchange nuevo — mayor riesgo de contraparte.')}</div>`:'')}
  </div>`;
}

function tipHtml(r){
  const l=(EX[r.long.ex]||{}).short, s=(EX[r.short.ex]||{}).short;
  const sp=r.spread;
  let spLine;
  if(sp==null) spLine=T('Entry: no price feed to check.','Entrada: sin precio para verificar.');
  else if(Math.abs(sp)<=0.05) spLine=T('Cheap entry — start flat, farm the funding.','Entrada barata — empiezas a la par y farmeas.');
  else spLine=T(`Entry costs ${sp.toFixed(2)}% — recovered by funding if it holds.`,`Entrada cuesta ${sp.toFixed(2)}% — se recupera con el funding si se mantiene.`);
  return `<div class="font-semibold text-white mb-1">${T('LONG','LARGO')} <span class="text-green-400">${l}</span> · ${T('SHORT','CORTO')} <span class="text-red-400">${s}</span></div>
    <div class="text-green-400 mb-0.5">+${r.netAPR.toFixed(1)}% APR</div>
    <div class="text-gray-400">${spLine}</div>`;
}

function bindRows(){
  const tip=$('tip');
  document.querySelectorAll('.row').forEach(tr=>{
    const i=+tr.dataset.i, r=window._show[i];
    tr.addEventListener('mouseenter',()=>{ tip.innerHTML=tipHtml(r); tip.classList.remove('hidden'); });
    tr.addEventListener('mousemove',e=>{ tip.style.left=Math.min(e.clientX+14,window.innerWidth-260)+'px'; tip.style.top=(e.clientY+14)+'px'; });
    tr.addEventListener('mouseleave',()=>tip.classList.add('hidden'));
    tr.addEventListener('click',()=>{
      const d=document.querySelector(`.detail[data-d="${i}"]`);
      if(d.classList.contains('hidden')){ d.querySelector('td').innerHTML=buildDetail(r); d.classList.remove('hidden'); }
      else d.classList.add('hidden');
    });
  });
}

function updateSortArrows(){ document.querySelectorAll('.sort-arrow').forEach(el=>{ el.textContent=el.dataset.key===sortKey?(sortDir<0?'▼':'▲'):''; }); }

// ─── DEX filter chips ───────────────────────────────────────────────────
function renderDexChips(){
  const box=$('dex-filter');
  box.innerHTML=Object.keys(EX).map(k=>{
    const on=enabledEx.has(k), m=EX[k];
    return `<button class="dex-chip text-xs font-semibold px-2 py-0.5 rounded border transition-opacity" data-ex="${k}"
      style="color:${m.color};border-color:${m.color}55;background:${m.color}14;opacity:${on?1:0.3}">${m.short}</button>`;
  }).join('');
  box.querySelectorAll('.dex-chip').forEach(b=>b.addEventListener('click',()=>{
    const k=b.dataset.ex; enabledEx.has(k)?enabledEx.delete(k):enabledEx.add(k);
    renderDexChips(); renderTable();
  }));
}

// ─── Load ───────────────────────────────────────────────────────────────
async function load(){
  setStatus('loading'); $('refresh-icon').style.animation='spin 0.8s linear infinite';
  const settled=await Promise.allSettled([...CLIENT.map(f=>f()), fetchProxy()]);
  const sources=[];
  settled.forEach(s=>{ if(s.status!=='fulfilled') return; Array.isArray(s.value)?sources.push(...s.value):sources.push(s.value); });
  const live=sources.filter(s=>s.data&&Object.keys(s.data).length).length;
  $('stat-sources').textContent=`${live}/${Object.keys(EX).length}`;
  rows=buildRows(sources);
  renderTable();
  setStatus(live===0?'error':'live');
  $('refresh-icon').style.animation='';
}

// ─── Auto-refresh & events ──────────────────────────────────────────────
function startCountdown(){ clearInterval(timer);cd=60;$('stat-refresh').textContent='60s';
  timer=setInterval(()=>{cd--;$('stat-refresh').textContent=`${cd}s`;if(cd<=0){cd=60;load();}},1000); }
function stopCountdown(){ clearInterval(timer);$('stat-refresh').textContent='OFF'; }

$('autorefresh-toggle').addEventListener('click',()=>{ autoOn=!autoOn;$('autorefresh-toggle').classList.toggle('opacity-40',!autoOn); autoOn?startCountdown():stopCountdown(); });
$('search').addEventListener('input',renderTable);
$('min-depth').addEventListener('change',renderTable);
$('max-spread').addEventListener('change',renderTable);
$('min-apr').addEventListener('change',renderTable);
$('dex-all').addEventListener('click',()=>{ enabledEx=new Set(Object.keys(EX)); renderDexChips(); renderTable(); });
$('dex-none').addEventListener('click',()=>{ enabledEx=new Set(); renderDexChips(); renderTable(); });
$('refresh-btn').addEventListener('click',()=>{ if(autoOn)startCountdown(); load(); });
document.querySelectorAll('.sortable').forEach(th=>th.addEventListener('click',()=>{ const k=th.dataset.sort; if(sortKey===k)sortDir*=-1; else{sortKey=k;sortDir=-1;} renderTable(); }));

document.head.insertAdjacentHTML('beforeend','<style>@keyframes spin{to{transform:rotate(360deg)}}</style>');
enabledEx=new Set(Object.keys(EX)); renderDexChips();
load(); startCountdown();
</script>
