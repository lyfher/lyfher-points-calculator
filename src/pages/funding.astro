function bindRows(){
  const tip=$('tip');
  document.querySelectorAll('.row').forEach(tr=>{
    const i=+tr.dataset.i, r=window._show[i];
    tr.addEventListener('mouseenter',()=>{ tip.innerHTML=tipHtml(r); tip.classList.remove('hidden'); });
    tr.addEventListener('mousemove',e=>{ tip.style.left=Math.min(e.clientX+14,window.innerWidth-260)+'px'; tip.style.top=(e.clientY+14)+'px'; });
    tr.addEventListener('mouseleave',()=>tip.classList.add('hidden'));
    tr.addEventListener('click',()=>{
      const d=document.querySelector(`.detail[data-d="${i}"]`);
      if(d.classList.contains('hidden')){ d.querySelector('td').innerHTML=buildDetail(r); d.classList.remove('hidden'); openDetails.add(r.coin); }
      else { d.classList.add('hidden'); openDetails.delete(r.coin); }
    });
    // keep expanded panels open across auto-refresh, just refreshing their content
    if(openDetails.has(r.coin)){ const d=document.querySelector(`.detail[data-d="${i}"]`); d.querySelector('td').innerHTML=buildDetail(r); d.classList.remove('hidden'); }
  });
}

function updateSortArrows(){ document.querySelectorAll('.sort-arrow').forEach(el=>{ el.textContent=el.dataset.key===sortKey?(sortDir<0?'▼':'▲'):''; }); }

// ── Browser opportunity alerts (sound + notification, tab must be open) ──
function beep(){
  try{ audioCtx=audioCtx||new (window.AudioContext||window.webkitAudioContext)();
    const t=audioCtx.currentTime;
    [0,0.16].forEach(off=>{ const o=audioCtx.createOscillator(),g=audioCtx.createGain();
      o.type='sine'; o.frequency.value=880; o.connect(g); g.connect(audioCtx.destination);
      g.gain.setValueAtTime(0.0001,t+off); g.gain.exponentialRampToValueAtTime(0.25,t+off+0.02); g.gain.exponentialRampToValueAtTime(0.0001,t+off+0.14);
      o.start(t+off); o.stop(t+off+0.15); });
  }catch{}
}
function alertCandidates(){
  // opportunities passing current filters (depth/spread/dex) above the alert APR
  return getFiltered().filter(r=>r.netAPR>=alertThr).map(r=>r.coin);
}
function updateAlertCount(){
  const el=$('alert-count'); if(!el) return;
  el.textContent = alertThr ? `${alertCandidates().length} ${T('live','activas')}` : '';
}
function toast(html){
  const box=$('toasts'); if(!box) return;
  const el=document.createElement('div');
  el.className='cursor-pointer bg-gray-900 border border-green-500/50 rounded-xl px-4 py-3 text-sm text-white max-w-xs';
  el.style.cssText='box-shadow:0 0 24px rgba(34,197,94,0.22);animation:slidein .25s ease';
  el.innerHTML=html;
  el.addEventListener('click',()=>el.remove());
  box.appendChild(el);
  setTimeout(()=>{ el.style.transition='opacity .4s,transform .4s'; el.style.opacity='0'; el.style.transform='translateX(20px)'; setTimeout(()=>el.remove(),400); }, 7000);
}
function primeAlerts(){ prevAlerted=new Set(alertThr?alertCandidates():[]); }
function checkAlerts(){
  if(!alertThr){ prevAlerted.clear(); return; }
  const cur=alertCandidates(), curSet=new Set(cur);
  const fresh=cur.filter(c=>!prevAlerted.has(c));
  prevAlerted=curSet;
  if(!fresh.length) return;
  beep();
  const rows=window._show||[]; const legs=c=>{const r=rows.find(x=>x.coin===c); return r?`${(EX[r.long.ex]||{}).short}/${(EX[r.short.ex]||{}).short}`:'';};
  const apr=c=>{const r=rows.find(x=>x.coin===c); return r?'+'+r.netAPR.toFixed(0)+'%':'';};
  // in-page toast (works even if OS notifications are blocked)
  const items=fresh.slice(0,4).map(c=>`<div class="flex items-center gap-2"><span class="text-green-400">🔥</span> <b>${c}</b> <span class="text-green-400 font-semibold">${apr(c)}</span> <span class="text-gray-500 text-xs">${legs(c)}</span></div>`).join('');
  const more=fresh.length>4?`<div class="text-gray-500 text-xs mt-1">+${fresh.length-4} ${T('more','más')}</div>`:'';
  toast(`<div class="font-semibold text-green-400 mb-1">🔔 ${T('New opportunity','Nueva oportunidad')}${fresh.length>1?' ('+fresh.length+')':''}</div>${items}${more}`);
  // OS notification if allowed
  if('Notification' in window && Notification.permission==='granted'){
    const body=fresh.slice(0,5).map(c=>`${c} ${apr(c)}`).join(', ')+(fresh.length>5?` +${fresh.length-5}`:'');
    try{ new Notification('Lyfher — '+T('new opportunity','nueva oportunidad'), {body, icon:'/favicon.svg'}); }catch{}
  }
}

// ⓘ help markers on column headers (hover on desktop, tap on mobile)
function bindHelp(){
  const tip=$('tip');
  document.querySelectorAll('.help').forEach(el=>{
    const show=()=>{ tip.innerHTML=lang()==='es'?el.dataset.tipEs:el.dataset.tipEn; tip.classList.remove('hidden');
      const r=el.getBoundingClientRect(); tip.style.left=Math.min(r.left,window.innerWidth-260)+'px'; tip.style.top=(r.bottom+8)+'px'; };
    el.addEventListener('mouseenter',show);
    el.addEventListener('mouseleave',()=>tip.classList.add('hidden'));
    el.addEventListener('click',e=>{ e.stopPropagation(); tip.classList.contains('hidden')?show():tip.classList.add('hidden'); });
  });
}

// ─── Heatmap ────────────────────────────────────────────────────────────
function heatColor(a){
  if(a==null) return 'background:#0b0f1a;color:#374151';
  const cap=Math.min(Math.abs(a),40)/40;          // saturate at ±40% APR
  const alpha=(0.15+cap*0.6).toFixed(2);
  const rgb=a<0?'34,197,94':'239,68,68';          // neg=green(long), pos=red(short)
  return `background:rgba(${rgb},${alpha});color:${cap>0.45?'#fff':'#cbd5e1'}`;
}
function renderHeat(){
  const exs=Object.keys(EX).filter(k=>enabledEx.has(k));
  let show=getFiltered().sort((a,b)=>b.netAPR-a.netAPR).slice(0,40);
  updateStats(getFiltered());
  if(!show.length||!exs.length){ $('heat-body').innerHTML=`<div class="text-center py-16 text-gray-600">${T('No results — loosen the filters','Sin resultados — afloja los filtros')}</div>`; return; }
  const cols=`grid-template-columns:72px repeat(${exs.length},minmax(58px,1fr))`;
  const head=`<div class="text-xs text-gray-500 font-semibold px-2 py-1"></div>`+
    exs.map(k=>`<div class="text-[10px] font-semibold text-center px-1 py-1 leading-tight" style="color:${EX[k].color}">${EX[k].short}</div>`).join('');
  window._heatRows={}; show.forEach(r=>window._heatRows[r.coin]=r);
  const body=show.map(r=>{
    const m={}; r.legs.forEach(l=>m[l.ex]=l.apr);
    const label=`<div class="text-xs font-bold text-white px-2 py-1.5 flex items-center">${r.coin}</div>`;
    const cells=exs.map(k=>{
      const a=m[k];
      const isL=r.long&&r.long.ex===k, isS=r.short&&r.short.ex===k;
      const ring=isL?'box-shadow:inset 0 0 0 1.5px #22c55e':isS?'box-shadow:inset 0 0 0 1.5px #ef4444':'';
      const cur=a==null?'cursor-default':'cursor-help';
      return `<div class="heat-cell text-[11px] font-mono text-center py-1.5 rounded ${cur}" data-coin="${r.coin}" data-ex="${k}" style="${heatColor(a)};${ring}">${a==null?'·':(a>=0?'+':'')+a.toFixed(0)}</div>`;
    }).join('');
    return label+cells;
  }).join('');
  $('heat-body').innerHTML=`<div class="grid gap-1 items-center" style="${cols}">${head}${body}</div>`;
  bindHeat();
}
function heatTip(coin, ex){
  const r=window._heatRows[coin]; const m=EX[ex]||{short:ex,color:'#9ca3af'};
  const leg=r&&r.legs.find(l=>l.ex===ex);
  const title=`<div class="font-semibold text-white mb-1">${coin} · <span style="color:${m.color}">${m.short}</span></div>`;
  if(!leg) return title+`<div class="text-gray-500">${T('No market here.','Sin mercado aquí.')}</div>`;
  const a=leg.apr;
  const fund=`<div class="mb-1"><span class="text-gray-400">${T('Funding','Funding')}: </span><span class="font-mono ${a>=0?'text-red-400':'text-green-400'}">${a>=0?'+':''}${a.toFixed(2)}% APR</span></div>`;
  const action=a<0
    ? `<div class="text-green-400 font-semibold">▲ ${T('LONG here — funding pays longs','LARGO aquí — el funding paga a los largos')}</div>`
    : `<div class="text-red-400 font-semibold">▼ ${T('SHORT here — funding pays shorts','CORTO aquí — el funding paga a los cortos')}</div>`;
  let pair='';
  if(r.long.ex===ex) pair=`<div class="text-gray-400 mt-1">★ ${T('Best long leg','Mejor pata larga')} — ${T('pair w/ SHORT','contra CORTO')} <span style="color:${(EX[r.short.ex]||{}).color}">${(EX[r.short.ex]||{}).short}</span> = <span class="text-green-400">+${r.netAPR.toFixed(1)}%</span></div>`;
  else if(r.short.ex===ex) pair=`<div class="text-gray-400 mt-1">★ ${T('Best short leg','Mejor pata corta')} — ${T('pair w/ LONG','contra LARGO')} <span style="color:${(EX[r.long.ex]||{}).color}">${(EX[r.long.ex]||{}).short}</span> = <span class="text-green-400">+${r.netAPR.toFixed(1)}%</span></div>`;
  return title+fund+action+pair;
}
function bindHeat(){
  const tip=$('tip');
  document.querySelectorAll('.heat-cell').forEach(c=>{
    c.addEventListener('mouseenter',()=>{ tip.innerHTML=heatTip(c.dataset.coin,c.dataset.ex); tip.classList.remove('hidden'); });
    c.addEventListener('mousemove',e=>{ tip.style.left=Math.min(e.clientX+14,window.innerWidth-260)+'px'; tip.style.top=(e.clientY+14)+'px'; });
    c.addEventListener('mouseleave',()=>tip.classList.add('hidden'));
  });
}
function setView(v){
  view=v;
  $('table-wrap').classList.toggle('hidden',v!=='table');
  $('heat-wrap').classList.toggle('hidden',v!=='heat');
  document.querySelectorAll('.view-btn').forEach(b=>{ const on=b.dataset.view===v;
    b.classList.toggle('bg-gray-700',on); b.classList.toggle('text-white',on); b.classList.toggle('text-gray-500',!on); });
  render();
}

// ─── DEX filter chips ───────────────────────────────────────────────────
function renderDexChips(){
  const box=$('dex-filter');
  box.innerHTML=Object.keys(EX).map(k=>{
    const on=enabledEx.has(k), m=EX[k];
    return `<button class="dex-chip text-xs font-semibold px-2 py-0.5 rounded border transition-opacity" data-ex="${k}"
      style="color:${m.color};border-color:${m.color}55;background:${m.color}14;opacity:${on?1:0.3}">${m.short}</button>`;
  }).join('');
  box.querySelectorAll('.dex-chip').forEach(b=>b.addEventListener('click',()=>{
    const k=b.dataset.ex; enabledEx.has(k)?enabledEx.delete(k):enabledEx.add(k);
    renderDexChips(); render();
  }));
}

// ─── Load ───────────────────────────────────────────────────────────────
async function load(){
  setStatus('loading'); $('refresh-icon').style.animation='spin 0.8s linear infinite';
  const settled=await Promise.allSettled([...CLIENT.map(f=>f()), fetchProxy()]);
  const sources=[];
  settled.forEach(s=>{ if(s.status!=='fulfilled') return; Array.isArray(s.value)?sources.push(...s.value):sources.push(s.value); });
  const live=sources.filter(s=>s.data&&Object.keys(s.data).length).length;
  $('stat-sources').textContent=`${live}/${Object.keys(EX).length}`;
  try{ const hr=await fetch('/history.json',{cache:'no-store'}); if(hr.ok){ const h=await hr.json(); hist=h.points||{}; spreadHist=h.spreads||{}; } }catch{}
  rows=buildRows(sources);
  render();
  if(alertThr){ if(!window._alertsReady){ primeAlerts(); window._alertsReady=true; } else checkAlerts(); }
  setStatus(live===0?'error':'live');
  $('refresh-icon').style.animation='';
}

// ─── Auto-refresh & events ──────────────────────────────────────────────
function startCountdown(){ clearInterval(timer);cd=REFRESH_SEC;$('stat-refresh').textContent=REFRESH_SEC+'s';
  timer=setInterval(()=>{cd--;$('stat-refresh').textContent=`${cd}s`;if(cd<=0){cd=REFRESH_SEC;load();}},1000); }
function stopCountdown(){ clearInterval(timer);$('stat-refresh').textContent='OFF'; }

$('autorefresh-toggle').addEventListener('click',()=>{ autoOn=!autoOn;$('autorefresh-toggle').classList.toggle('opacity-40',!autoOn); autoOn?startCountdown():stopCountdown(); });
$('search').addEventListener('input',render);
$('min-depth').addEventListener('change',render);
$('max-spread').addEventListener('change',render);
$('min-apr').addEventListener('change',render);
$('capital').addEventListener('input',render);
$('dex-all').addEventListener('click',()=>{ enabledEx=new Set(Object.keys(EX)); renderDexChips(); render(); });
$('dex-none').addEventListener('click',()=>{ enabledEx=new Set(); renderDexChips(); render(); });
$('refresh-btn').addEventListener('click',()=>{ if(autoOn)startCountdown(); load(); });
$('view-table').addEventListener('click',()=>setView('table'));
$('view-heat').addEventListener('click',()=>setView('heat'));
$('alert-apr').addEventListener('change',e=>{
  alertThr=parseFloat(e.target.value)||0;
  try{ localStorage.setItem('lyfher_alert_apr', e.target.value); }catch{}
  $('alert-label').classList.toggle('text-green-400', alertThr>0);
  $('alert-label').classList.toggle('text-gray-500', alertThr===0);
  if(alertThr>0){
    if('Notification' in window && Notification.permission==='default') Notification.requestPermission();
    try{ beep(); }catch{}          // unlock audio on user gesture + confirm it works
    primeAlerts(); window._alertsReady=true;
  }else{ prevAlerted.clear(); window._alertsReady=false; }
  updateAlertCount();
});
document.querySelectorAll('.sortable').forEach(th=>th.addEventListener('click',()=>{ const k=th.dataset.sort; if(sortKey===k)sortDir*=-1; else{sortKey=k;sortDir=-1;} renderTable(); }));

document.head.insertAdjacentHTML('beforeend','<style>@keyframes spin{to{transform:rotate(360deg)}}@keyframes slidein{from{opacity:0;transform:translateX(20px)}to{opacity:1;transform:translateX(0)}}.help{margin-left:3px;color:#6b7280;cursor:help;font-weight:400}.help:hover{color:#d1d5db}</style>');
enabledEx=new Set(Object.keys(EX)); renderDexChips(); bindHelp();
try{ const sv=localStorage.getItem('lyfher_alert_apr'); if(sv&&sv!=='0'){ $('alert-apr').value=sv; alertThr=parseFloat(sv)||0; $('alert-label').classList.add('text-green-400'); $('alert-label').classList.remove('text-gray-500'); } }catch{}
load(); startCountdown();
</script>
