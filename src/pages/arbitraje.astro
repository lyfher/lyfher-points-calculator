---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Lyfher — Arbitrage Scanner" description="Real-time arbitrage between Polymarket and Hyperliquid HIP-4 outcome markets.">

<!-- Hero -->
<section class="text-center py-10">
  <h1 class="text-4xl sm:text-5xl font-bold text-white mb-3">
    <span data-en="Arbitrage" data-es="Arbitraje">Arbitrage</span>
    <span class="text-green-400"> Scanner</span>
  </h1>
  <p class="text-gray-400 text-base max-w-xl mx-auto"
     data-en="Real-time arb detection between Polymarket and Hyperliquid HIP-4 outcome markets."
     data-es="Detección de arbitraje en tiempo real entre Polymarket e Hyperliquid HIP-4.">
    Real-time arb detection between Polymarket and Hyperliquid HIP-4 outcome markets.
  </p>
</section>

<!-- Stats -->
<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
  <div class="bg-gray-900 border border-gray-800 rounded-xl p-3 text-center">
    <div id="stat-arbs" class="text-2xl font-bold text-green-400">—</div>
    <div class="text-xs text-gray-500 mt-0.5" data-en="Arbs found" data-es="Arbs encontradas">Arbs found</div>
  </div>
  <div class="bg-gray-900 border border-gray-800 rounded-xl p-3 text-center">
    <div id="stat-hl" class="text-2xl font-bold text-blue-400">—</div>
    <div class="text-xs text-gray-500 mt-0.5">Hyperliquid</div>
  </div>
  <div class="bg-gray-900 border border-gray-800 rounded-xl p-3 text-center">
    <div id="stat-poly" class="text-2xl font-bold text-purple-400">—</div>
    <div class="text-xs text-gray-500 mt-0.5">Polymarket</div>
  </div>
  <div id="autorefresh-toggle" class="bg-gray-900 border border-gray-800 rounded-xl p-3 text-center cursor-pointer select-none">
    <div id="stat-refresh" class="text-2xl font-bold text-yellow-400">30s</div>
    <div class="text-xs text-gray-500 mt-0.5" data-en="Auto-refresh" data-es="Auto-actualizar">Auto-refresh</div>
  </div>
</div>

<!-- Controls -->
<div class="flex items-center justify-between mb-5 gap-3 flex-wrap">
  <div class="flex items-center gap-2">
    <div id="status-dot" class="w-2.5 h-2.5 rounded-full bg-yellow-500 animate-pulse shrink-0"></div>
    <span id="status-text" class="text-sm text-gray-500">Loading…</span>
  </div>
  <div class="flex items-center gap-2">
    <select id="view-mode" class="bg-gray-900 border border-gray-700 text-white text-sm rounded-lg px-3 py-1.5 focus:outline-none focus:border-green-500">
      <option value="arbs" data-en="Arbs only" data-es="Solo arbs">Arbs only</option>
      <option value="all" data-en="All markets" data-es="Todos los mercados">All markets</option>
    </select>
    <button id="refresh-btn" class="flex items-center gap-2 bg-gray-900 border border-gray-700 hover:border-green-500 text-white text-sm font-medium px-4 py-1.5 rounded-lg transition-colors">
      <span id="refresh-icon" class="inline-block">↻</span>
      <span data-en="Refresh" data-es="Actualizar">Refresh</span>
    </button>
  </div>
</div>

<!-- Stake Calculator -->
<div class="bg-gray-900/60 border border-gray-800 rounded-2xl p-4 mb-6">
  <div id="calc-toggle" class="flex items-center justify-between cursor-pointer select-none">
    <span class="text-sm font-semibold text-white">
      💰 <span data-en="Stake Calculator" data-es="Calculadora de apuesta">Stake Calculator</span>
    </span>
    <span id="calc-chevron" class="text-gray-500 text-sm">▼</span>
  </div>
  <div id="calc-body" class="hidden mt-4">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-end">
      <div>
        <label class="block text-xs text-gray-500 mb-1" data-en="Total budget ($)" data-es="Presupuesto ($)">Total budget ($)</label>
        <input id="calc-budget" type="number" value="100" min="1"
               class="w-full bg-gray-950 border border-gray-700 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-green-500"/>
      </div>
      <div>
        <label class="block text-xs text-gray-500 mb-1">Odd A (decimal)</label>
        <input id="calc-a" type="number" step="0.01" placeholder="e.g. 2.10"
               class="w-full bg-gray-950 border border-gray-700 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-green-500"/>
      </div>
      <div>
        <label class="block text-xs text-gray-500 mb-1">Odd B (decimal)</label>
        <input id="calc-b" type="number" step="0.01" placeholder="e.g. 2.15"
               class="w-full bg-gray-950 border border-gray-700 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-green-500"/>
      </div>
    </div>
    <div id="calc-result" class="hidden mt-4 bg-gray-950 border border-green-800 rounded-xl p-4">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
        <div><div class="text-xs text-gray-500 mb-1" data-en="Stake A" data-es="Apuesta A">Stake A</div><div id="calc-sa" class="text-xl font-bold text-white">—</div></div>
        <div><div class="text-xs text-gray-500 mb-1" data-en="Stake B" data-es="Apuesta B">Stake B</div><div id="calc-sb" class="text-xl font-bold text-white">—</div></div>
        <div><div class="text-xs text-gray-500 mb-1" data-en="Profit" data-es="Ganancia">Profit</div><div id="calc-profit" class="text-xl font-bold text-green-400">—</div></div>
        <div><div class="text-xs text-gray-500 mb-1">ROI</div><div id="calc-roi" class="text-xl font-bold text-green-400">—</div></div>
      </div>
    </div>
  </div>
</div>

<!-- Results -->
<div id="skeleton" class="grid gap-4">
  {Array.from({length:3}).map(()=>(
    <div class="bg-gray-900 border border-gray-800 rounded-2xl p-5 animate-pulse">
      <div class="flex justify-between mb-3"><div class="h-4 bg-gray-800 rounded w-3/5"></div><div class="h-6 bg-gray-800 rounded w-16"></div></div>
      <div class="h-3 bg-gray-800 rounded w-2/5 mb-4"></div>
      <div class="grid grid-cols-2 gap-3"><div class="h-24 bg-gray-800 rounded-xl"></div><div class="h-24 bg-gray-800 rounded-xl"></div></div>
    </div>
  ))}
</div>
<div id="main-list" class="grid gap-4 hidden"></div>
<div id="empty-state" class="hidden text-center py-16">
  <div class="text-4xl mb-3">🔍</div>
  <p class="text-gray-500 text-sm"
     data-en="No arbs found right now. Try 'All markets' view or wait for the next refresh."
     data-es="No hay arbs ahora. Prueba la vista 'Todos los mercados' o espera el próximo refresh.">
    No arbs found right now. Try 'All markets' view or wait for the next refresh.
  </p>
</div>

<!-- Platform legend -->
<div class="flex items-center gap-4 mt-6 mb-2">
  <div class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-blue-500 inline-block"></span><span class="text-xs text-gray-500">Hyperliquid HIP-4</span></div>
  <div class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-purple-500 inline-block"></span><span class="text-xs text-gray-500">Polymarket</span></div>
  <div class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block"></span><span class="text-xs text-gray-500" data-en="Cross-platform arb" data-es="Arb cross-platform">Cross-platform arb</span></div>
</div>

<section class="mt-8 border-t border-gray-800 pt-6 text-center">
  <p class="text-gray-600 text-sm max-w-xl mx-auto"
     data-en="Arbs disappear fast. HL charges no open fee; Polymarket charges ~3.75% on wins. Always verify before placing."
     data-es="Los arbs duran poco. HL no cobra por abrir; Polymarket cobra ~3.75% en ganancias. Verifica siempre antes de apostar.">
    Arbs disappear fast. HL charges no open fee; Polymarket charges ~3.75% on wins. Always verify before placing.
  </p>
</section>

</Layout>

<script is:inline>
const REFRESH_MS = 30000;
let allCards = [], prevArbIds = new Set(), timer = null, autoOn = true, cd = 30;
const $ = id => document.getElementById(id);
const lang = () => document.documentElement.lang || 'en';

// ─── Status ───────────────────────────────────────────────────────────────────
function setStatus(s) {
  const t={loading:{en:'Loading…',es:'Cargando…'},live:{en:'Up to date',es:'Actualizado'},error:{en:'Error',es:'Error'}};
  const c={loading:'bg-yellow-500 animate-pulse',live:'bg-green-500',error:'bg-red-500'};
  $('status-dot').className=`w-2.5 h-2.5 rounded-full ${c[s]} shrink-0`;
  $('status-text').textContent=t[s][lang()]||t[s].en;
}

// ─── Alert ────────────────────────────────────────────────────────────────────
function beep() {
  try {
    const ctx=new AudioContext();
    [880,1100,880].forEach((f,i)=>{
      const o=ctx.createOscillator(),g=ctx.createGain();
      o.connect(g);g.connect(ctx.destination);
      o.frequency.value=f;
      const t=ctx.currentTime+i*0.13;
      g.gain.setValueAtTime(0.25,t);
      g.gain.exponentialRampToValueAtTime(0.001,t+0.1);
      o.start(t);o.stop(t+0.1);
    });
  } catch(e){}
}

// ─── Calc ─────────────────────────────────────────────────────────────────────
function updateCalc() {
  const b=parseFloat($('calc-budget').value)||0,a=parseFloat($('calc-a').value)||0,bv=parseFloat($('calc-b').value)||0;
  if(!b||a<=1||bv<=1){$('calc-result').classList.add('hidden');return;}
  const ia=1/a,ib=1/bv,tot=ia+ib;
  if(tot>=1){$('calc-result').classList.add('hidden');return;}
  const sa=b*(ia/tot),sb=b*(ib/tot),profit=sa*a-b;
  $('calc-sa').textContent=`$${sa.toFixed(2)}`;
  $('calc-sb').textContent=`$${sb.toFixed(2)}`;
  $('calc-profit').textContent=`+$${profit.toFixed(2)}`;
  $('calc-roi').textContent=`+${((profit/b)*100).toFixed(2)}%`;
  $('calc-result').classList.remove('hidden');
}

// ─── Parse HL description ─────────────────────────────────────────────────────
function parseHLDesc(desc) {
  const p={};
  desc.split('|').forEach(part=>{const [k,v]=part.split(':');if(k&&v)p[k]=v;});
  return p;
}

function hlTitle(desc) {
  const p=parseHLDesc(desc);
  if(p.class==='priceBinary') {
    const expiry=p.expiry||'';
    const match=expiry.match(/(\d{4})(\d{2})(\d{2})-(\d{4})/);
    let dateStr=expiry;
    if(match) {
      const d=new Date(`${match[1]}-${match[2]}-${match[3]}T${match[4].slice(0,2)}:${match[4].slice(2)}:00Z`);
      dateStr=d.toLocaleDateString(undefined,{month:'short',day:'numeric'})+' '+d.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})+'  UTC';
    }
    const price=p.targetPrice?`$${Number(p.targetPrice).toLocaleString()}`:'';
    return `Will ${p.underlying||'BTC'} be above ${price} at ${dateStr}?`;
  }
  return desc;
}

// ─── Render card ──────────────────────────────────────────────────────────────
function platformBadge(src) {
  if(src==='hl') return '<span class="text-xs px-2 py-0.5 rounded bg-blue-900/40 border border-blue-800 text-blue-400">⚡ Hyperliquid</span>';
  if(src==='poly') return '<span class="text-xs px-2 py-0.5 rounded bg-purple-900/40 border border-purple-800 text-purple-400">🔮 Polymarket</span>';
  return '<span class="text-xs px-2 py-0.5 rounded bg-green-900/40 border border-green-800 text-green-400">🔀 Cross-arb</span>';
}

function renderCard(card) {
  const isArb = card.roi!=null && card.roi>0;
  const roiHtml = isArb
    ? `<span class="shrink-0 text-xl font-bold ${card.roi>=5?'text-green-300':card.roi>=2?'text-green-400':'text-emerald-500'}">+${card.roi.toFixed(2)}%</span>`
    : '';

  const sidesHtml = card.sides.map(s=>`
    <div class="bg-gray-950 border border-gray-800 rounded-xl p-3 flex flex-col gap-1">
      <div class="flex items-center justify-between gap-1">
        <span class="text-xs font-semibold ${s.color||'text-gray-400'} truncate">${s.platform}</span>
        ${s.url?`<a href="${s.url}" target="_blank" rel="noopener noreferrer" class="text-xs text-blue-500 hover:text-blue-300 shrink-0">→</a>`:''}
      </div>
      <div class="text-xs text-gray-500">${s.label}</div>
      <div class="text-xl font-bold text-white">${s.mid!=null?s.mid.toFixed(3):'—'}</div>
      <div class="flex gap-2 text-xs text-gray-600">
        ${s.bid!=null?`<span>bid <span class="text-gray-400">${s.bid.toFixed(3)}</span></span>`:''}
        ${s.ask!=null?`<span>ask <span class="text-gray-400">${s.ask.toFixed(3)}</span></span>`:''}
      </div>
      ${isArb&&s.stake?`<div class="text-xs text-gray-600 mt-1">stake <span class="text-gray-400">$${s.stake.toFixed(0)}</span></div>`:''}
    </div>`).join('');

  return `
    <div class="bg-gray-900 border ${isArb?'border-green-900 hover:border-green-700':'border-gray-800 hover:border-gray-600'} rounded-2xl p-5 transition-all">
      <div class="flex items-start justify-between gap-3 mb-1">
        <div class="min-w-0">
          <h2 class="text-white font-semibold text-sm sm:text-base leading-snug">${card.title}</h2>
        </div>
        ${roiHtml}
      </div>
      <div class="flex flex-wrap gap-2 mb-4">
        ${platformBadge(card.source)}
        ${card.expiry?`<span class="text-xs text-gray-600">${card.expiry}</span>`:''}
        ${card.volume?`<span class="text-xs text-gray-700">vol $${Number(card.volume).toLocaleString(undefined,{maximumFractionDigits:0})}</span>`:''}
      </div>
      <div class="grid grid-cols-2 gap-3">${sidesHtml}</div>
      ${isArb?`
      <button class="fill-calc mt-3 text-xs text-gray-600 hover:text-gray-400 transition-colors"
              data-a="${card.sides[0]?.decOdd}" data-b="${card.sides[1]?.decOdd}">
        ↓ <span data-en="Use in calculator" data-es="Usar en calculadora">Use in calculator</span>
      </button>`:''}
    </div>`;
}

function renderAll() {
  const mode=$('view-mode').value;
  const show=mode==='arbs'?allCards.filter(c=>c.roi!=null&&c.roi>0):allCards;

  $('stat-arbs').textContent=allCards.filter(c=>c.roi>0).length||'0';
  $('stat-hl').textContent=allCards.filter(c=>c.source==='hl').length||'0';
  $('stat-poly').textContent=allCards.filter(c=>c.source==='poly').length||'0';

  $('skeleton').classList.add('hidden');
  if(!show.length){
    $('main-list').classList.add('hidden');
    $('empty-state').classList.remove('hidden');
    return;
  }
  $('empty-state').classList.add('hidden');
  $('main-list').classList.remove('hidden');
  $('main-list').innerHTML=show.map(renderCard).join('');

  document.querySelectorAll('.fill-calc').forEach(btn=>{
    btn.addEventListener('click',()=>{
      $('calc-a').value=parseFloat(btn.dataset.a).toFixed(2);
      $('calc-b').value=parseFloat(btn.dataset.b).toFixed(2);
      $('calc-body').classList.remove('hidden');
      $('calc-chevron').textContent='▲';
      updateCalc();
      $('calc-toggle').scrollIntoView({behavior:'smooth',block:'center'});
    });
  });

  const l=lang();
  $('main-list').querySelectorAll('[data-en]').forEach(el=>{
    el.textContent=l==='es'?(el.dataset.es||el.dataset.en):el.dataset.en;
  });
}

// ─── Hyperliquid HIP-4 ────────────────────────────────────────────────────────
async function hl(path='https://api.hyperliquid.xyz/info',body) {
  const r=await fetch(path,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
  if(!r.ok) throw new Error('HL '+r.status);
  return r.json();
}

async function fetchHLMarkets() {
  const [meta,mids]=await Promise.all([
    hl({type:'outcomeMeta'}),
    hl({type:'allMids'}),
  ]);

  const outcomes=meta.outcomes||[];
  const cards=[];

  for(const outcome of outcomes) {
    const id=outcome.outcome;
    const encYes=10*id+0, encNo=10*id+1;
    const coinYes=`#${encYes}`, coinNo=`#${encNo}`;

    const midYes=parseFloat(mids[coinYes])||null;
    const midNo=parseFloat(mids[coinNo])||null;

    // Get L2 book for best bid/ask
    let yesBook={bid:null,ask:null}, noBook={bid:null,ask:null};
    try {
      const [yb,nb]=await Promise.all([
        hl({type:'l2Book',coin:coinYes}),
        hl({type:'l2Book',coin:coinNo}),
      ]);
      const bidsY=yb.levels?.[0]||[], asksY=yb.levels?.[1]||[];
      const bidsN=nb.levels?.[0]||[], asksN=nb.levels?.[1]||[];
      yesBook={bid:bidsY[0]?parseFloat(bidsY[0].px):null, ask:asksY[0]?parseFloat(asksY[0].px):null};
      noBook ={bid:bidsN[0]?parseFloat(bidsN[0].px):null, ask:asksN[0]?parseFloat(asksN[0].px):null};
    } catch(e){}

    // Parse expiry from description
    const p=parseHLDesc(outcome.description||'');
    let expiryStr='';
    const em=( p.expiry||'').match(/(\d{4})(\d{2})(\d{2})-(\d{4})/);
    if(em) {
      const d=new Date(`${em[1]}-${em[2]}-${em[3]}T${em[4].slice(0,2)}:${em[4].slice(2)}:00Z`);
      expiryStr=d.toLocaleDateString(undefined,{month:'short',day:'numeric'})+' '+d.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})+'  UTC';
    }

    // Internal arb check
    const yesAsk=yesBook.ask, noAsk=noBook.ask;
    let roi=null, stakes=null;
    if(yesAsk&&noAsk) {
      const sum=yesAsk+noAsk;
      if(sum<1.0) {
        roi=((1-sum)/sum)*100;
        const budget=100;
        const ia=1/yesAsk, ib=1/noAsk, tot=ia+ib; // wait, this is for decimal odds
        // Actually for binary: YES odd = 1/yesAsk, NO odd = 1/noAsk
        // But here yesAsk IS the price (0-1 range), not decimal odd
        // For binary contracts: buy YES at price P → if YES: get $1, lose P; if NO: lose P
        // stake_yes / stake_no = noAsk / yesAsk (for equal payout)
        const sv=budget*(noAsk/sum)*yesAsk, sn=budget*(yesAsk/sum)*noAsk; // simplified
        stakes=[sv,sn];
      }
    }

    const yesDecOdd=yesAsk&&yesAsk>0?1/yesAsk:null;
    const noDecOdd=noAsk&&noAsk>0?1/noAsk:null;

    cards.push({
      id:`hl-${id}`,
      title:hlTitle(outcome.description||''),
      source:'hl',
      roi:roi?Math.max(0,roi):0,
      expiry:expiryStr,
      volume:null,
      sides:[
        {platform:'Hyperliquid',label:'YES',color:'text-blue-400',mid:midYes,bid:yesBook.bid,ask:yesBook.ask,url:'https://app.hyperliquid.xyz/trade',stake:stakes?.[0],decOdd:yesDecOdd},
        {platform:'Hyperliquid',label:'NO', color:'text-blue-400',mid:midNo, bid:noBook.bid, ask:noBook.ask, url:'https://app.hyperliquid.xyz/trade',stake:stakes?.[1],decOdd:noDecOdd},
      ],
      hlOutcome:{id,p,yesAsk,noAsk,midYes,midNo},
    });
  }

  return cards;
}

// ─── Polymarket ───────────────────────────────────────────────────────────────
async function fetchPolymarkets() {
  const r=await fetch('https://gamma-api.polymarket.com/markets?active=true&limit=100&order=volume24hr&ascending=false');
  if(!r.ok) throw new Error('Polymarket '+r.status);
  const data=await r.json();

  return data.map(m=>{
    const prices=JSON.parse(m.outcomePrices||'[null,null]');
    const yesPrice=parseFloat(prices[0])||null;
    const noPrice=parseFloat(prices[1])||null;
    const yesAsk=parseFloat(m.bestAsk)||null;
    const noAsk=yesAsk?1-(parseFloat(m.bestBid)||0):null;

    let roi=null;
    if(yesAsk&&noAsk&&yesAsk+noAsk<1.0) {
      roi=((1-(yesAsk+noAsk))/(yesAsk+noAsk))*100;
    }

    const yesDecOdd=yesAsk&&yesAsk>0?1/yesAsk:null;
    const noDecOdd=noAsk&&noAsk>0?1/noAsk:null;
    const url=`https://polymarket.com/event/${m.slug}`;

    return {
      id:`poly-${m.id}`,
      title:m.question||'Unknown',
      source:'poly',
      roi:roi?Math.max(0,roi):0,
      expiry:m.endDateIso||null,
      volume:m.volume24hr||0,
      sides:[
        {platform:'Polymarket',label:'YES',color:'text-purple-400',mid:yesPrice,bid:parseFloat(m.bestBid)||null,ask:yesAsk,url,stake:null,decOdd:yesDecOdd},
        {platform:'Polymarket',label:'NO', color:'text-purple-400',mid:noPrice,bid:noAsk?1-yesAsk:null,ask:noAsk,url,stake:null,decOdd:noDecOdd},
      ],
      polySlug:m.slug,
      underlying:detectUnderlying(m.question||''),
    };
  });
}

// ─── Cross-platform arb (HL vs Polymarket) ────────────────────────────────────
function detectUnderlying(text) {
  const t=text.toLowerCase();
  if(t.includes('bitcoin')||t.includes('btc')) return 'BTC';
  if(t.includes('ethereum')||t.includes('eth')) return 'ETH';
  if(t.includes('solana')||t.includes('sol')) return 'SOL';
  return null;
}

function findCrossArbs(hlCards, polyCards) {
  const arbs=[];
  for(const hlCard of hlCards) {
    const p=hlCard.hlOutcome?.p||{};
    if(p.class!=='priceBinary'||!p.underlying||!p.targetPrice||!p.expiry) continue;
    const underlying=p.underlying;
    const targetPrice=parseFloat(p.targetPrice);

    // Find Polymarket markets about the same underlying
    const matching=polyCards.filter(pc=>pc.underlying===underlying);
    for(const pm of matching) {
      const pmYesMid=pm.sides[0].mid;
      const pmNoMid=pm.sides[1].mid;
      if(!pmYesMid||!pmNoMid) continue;

      const hlYesAsk=hlCard.hlOutcome?.yesAsk;
      const hlNoAsk=hlCard.hlOutcome?.noAsk;
      if(!hlYesAsk||!hlNoAsk) continue;

      // Check: HL YES (BTC above target) + PM NO (same direction → PM says BTC won't hit something)
      // This is complex — only flag when price divergence is large
      const hlYesMid=hlCard.hlOutcome?.midYes||0;
      const pmYesDecimal=pm.sides[0].ask?1/pm.sides[0].ask:null;
      const hlNoDecimal=hlNoAsk?1/hlNoAsk:null;

      // Buy HL YES + PM NO (HL says BTC above target; if PM has a related market)
      if(pmYesDecimal&&hlNoDecimal) {
        const sumPN=pm.sides[0].ask+(hlNoAsk||0);
        if(sumPN<0.97) {
          const roi=((1-sumPN)/sumPN)*100;
          arbs.push({
            id:`cross-${hlCard.id}-${pm.id}`,
            title:`${underlying}: HL ${hlYesMid>0.5?'YES':'NO'} × ${pm.title.slice(0,50)}`,
            source:'cross',
            roi,
            expiry:null,
            volume:null,
            sides:[
              {...pm.sides[0],platform:'Polymarket YES',label:`${underlying} related`},
              {...hlCard.sides[1],platform:'Hyperliquid NO',label:`above $${targetPrice.toLocaleString()}`},
            ],
          });
        }
      }
    }
  }
  return arbs;
}

// ─── Main load ────────────────────────────────────────────────────────────────
async function load() {
  setStatus('loading');
  $('refresh-icon').style.animation='spin 0.8s linear infinite';

  const [hlRes, polyRes]=await Promise.allSettled([fetchHLMarkets(), fetchPolymarkets()]);

  let hlCards=[], polyCards=[];
  if(hlRes.status==='fulfilled') hlCards=hlRes.value;
  if(polyRes.status==='fulfilled') polyCards=polyRes.value;

  const crossArbs=findCrossArbs(hlCards,polyCards);

  // Merge: arbs first (sorted by ROI), then HL markets, then top 10 Polymarket by volume
  const arbs=[...crossArbs,...hlCards.filter(c=>c.roi>0),...polyCards.filter(c=>c.roi>0)].sort((a,b)=>b.roi-a.roi);
  const topPoly=polyCards.sort((a,b)=>(b.volume||0)-(a.volume||0)).slice(0,10);
  allCards=[...arbs,...hlCards.filter(c=>!arbs.find(a=>a.id===c.id)),...topPoly.filter(c=>!arbs.find(a=>a.id===c.id))];

  // New arb alert
  const newArbs=arbs.filter(a=>a.roi>=2&&!prevArbIds.has(a.id));
  if(newArbs.length&&prevArbIds.size>0) beep();
  prevArbIds=new Set(arbs.map(a=>a.id));

  renderAll();
  setStatus(hlRes.status==='rejected'&&polyRes.status==='rejected'?'error':'live');
  $('refresh-icon').style.animation='';
}

// ─── Auto-refresh ─────────────────────────────────────────────────────────────
function startCountdown() {
  clearInterval(timer);cd=30;$('stat-refresh').textContent='30s';
  timer=setInterval(()=>{
    cd--;$('stat-refresh').textContent=`${cd}s`;
    if(cd<=0){cd=30;load();}
  },1000);
}
function stopCountdown(){clearInterval(timer);$('stat-refresh').textContent='OFF';}

$('autorefresh-toggle').addEventListener('click',()=>{
  autoOn=!autoOn;
  $('autorefresh-toggle').classList.toggle('opacity-40',!autoOn);
  autoOn?startCountdown():stopCountdown();
});
$('calc-toggle').addEventListener('click',()=>{
  $('calc-body').classList.toggle('hidden');
  $('calc-chevron').textContent=$('calc-body').classList.contains('hidden')?'▼':'▲';
});
['calc-budget','calc-a','calc-b'].forEach(id=>$(id).addEventListener('input',updateCalc));
$('view-mode').addEventListener('change',renderAll);
$('refresh-btn').addEventListener('click',()=>{if(autoOn)startCountdown();load();});

document.head.insertAdjacentHTML('beforeend','<style>@keyframes spin{to{transform:rotate(360deg)}}</style>');

load();
startCountdown();
</script>
