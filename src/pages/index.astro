---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';
import { tools } from '../data/tools';
import ProjectLogo from '../components/ProjectLogo.astro';
---

<Layout title="Lyfher — Delta-Neutral Funding Scanner & Airdrop Tools">
  <!-- Hero: Funding as the primary tool -->
  <section class="text-center py-12">
    <span class="inline-block text-xs font-semibold uppercase tracking-widest text-green-500 mb-3"
          data-en="Live farming tool" data-es="Herramienta de farming en vivo">Live farming tool</span>
    <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4">
      <span data-en="Farm the funding," data-es="Farmea el funding,">Farm the funding,</span>
      <span class="text-green-400" data-en=" stay neutral" data-es=" mantente neutral"> stay neutral</span>
    </h1>
    <p class="text-gray-400 text-lg max-w-xl mx-auto mb-6"
       data-en="Live funding rates across decentralized perp DEXs. Spot delta-neutral opportunities, filter out the noise, and capture the spread with zero price exposure."
       data-es="Funding en vivo entre perp DEXs descentralizados. Detecta oportunidades delta-neutral, filtra el ruido y captura el spread sin exposición al precio.">
      Live funding rates across decentralized perp DEXs — capture the spread with zero price exposure.
    </p>
    <a href="/funding"
       class="inline-flex items-center gap-2 bg-green-600 hover:bg-green-500 text-white text-sm font-semibold px-6 py-3 rounded-xl transition-colors">
      🔬 <span data-en="Open the Delta-Neutral Scanner" data-es="Abrir el Scanner Delta-Neutral">Open the Delta-Neutral Scanner</span>
      <span>→</span>
    </a>
  </section>

  <!-- Tools & Bots -->
  <div class="flex items-center gap-3 mb-4">
    <span class="text-xs font-semibold uppercase tracking-widest text-gray-500" data-en="Tools & Bots" data-es="Herramientas y Bots">Tools & Bots</span>
    <div class="flex-1 h-px bg-gray-800"></div>
  </div>

  <section class="grid gap-6 sm:grid-cols-2 mb-10">
    {tools.map((tool) => (
      <div class="group bg-gray-900 border border-gray-800 rounded-2xl p-6 hover:border-gray-600 hover:bg-gray-800 transition-all duration-200">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-3">
            {tool.logoSrc
              ? <img src={tool.logoSrc} alt={tool.name} class="w-10 h-10 rounded-xl object-cover" />
              : <span class="text-3xl">{tool.logoEmoji}</span>
            }
            <h2 class="text-xl font-bold text-white">{tool.name}</h2>
          </div>
          <span class="text-xs font-semibold px-2 py-1 rounded-lg border"
                style={`color: ${tool.accentHex}; border-color: ${tool.accentHex}40; background: ${tool.accentHex}12`}
                data-en={tool.tag} data-es={tool.tagEs}>
            {tool.tag}
          </span>
        </div>
        <p class="text-gray-400 text-sm leading-relaxed mb-4"
           data-en={tool.description} data-es={tool.descriptionEs}>
          {tool.description}
        </p>
        <div class="flex items-center justify-between">
          <a href={tool.referralLink} target="_blank" rel="noopener noreferrer"
             class="text-sm font-medium hover:opacity-80 transition-opacity"
             style={`color: ${tool.accentHex}`}
             data-en={tool.referralBenefit} data-es={tool.referralBenefitEs}>
            {tool.referralBenefit} →
          </a>
          {tool.calculatorSlug && (
            <a href={`/${tool.calculatorSlug}`}
               class="text-xs text-gray-500 hover:text-gray-300 transition-colors"
               data-en="Calculate points →" data-es="Calcular puntos →">
              Calculate points →
            </a>
          )}
        </div>
      </div>
    ))}
  </section>

  <!-- Points Calculators (secondary) -->
  <div class="flex items-center gap-3 mb-2">
    <span class="text-xs font-semibold uppercase tracking-widest text-gray-500" data-en="Points Calculators" data-es="Calculadoras de Puntos">Points Calculators</span>
    <div class="flex-1 h-px bg-gray-800"></div>
  </div>
  <p class="text-gray-600 text-sm mb-4"
     data-en="Estimate the USD value of your points on each perp protocol across FDV scenarios."
     data-es="Estima el valor en USD de tus puntos en cada protocolo de perps según escenarios de FDV.">
    Estimate the USD value of your points across FDV scenarios.
  </p>

  <div class="flex mb-6">
    <a href="/compare"
       class="inline-flex items-center gap-2 bg-gray-900 border border-gray-700 hover:border-gray-500 text-white text-sm font-medium px-5 py-2.5 rounded-xl transition-colors">
      ⚖️ <span data-en="Compare all projects" data-es="Comparar todos los proyectos">Compare all projects</span>
      <span class="text-gray-500">→</span>
    </a>
  </div>

  <section class="grid gap-6 sm:grid-cols-2">
    {projects.filter(p => p.slug !== 'treadfi').map((project) => (
      <a
        href={`/${project.slug}`}
        class="group block bg-gray-900 border border-gray-800 rounded-2xl p-6 hover:border-gray-600 hover:bg-gray-800 transition-all duration-200"
      >
        <div class="flex items-center gap-3 mb-3">
          <ProjectLogo logoSrc={project.logoSrc} logoEmoji={project.logoEmoji} name={project.name} size="md" />
          <h2 class="text-xl font-bold text-white group-hover:text-blue-400 transition-colors">
            {project.name}
          </h2>
        </div>
        <p
          class="text-gray-400 text-sm leading-relaxed mb-4"
          data-en={project.description}
          data-es={project.descriptionEs}
        >
          {project.description}
        </p>
        <span
          class="text-blue-400 text-sm font-medium"
          data-en="Calculate points →"
          data-es="Calcular puntos →"
        >
          Calculate points →
        </span>
      </a>
    ))}

    <!-- More coming soon -->
    <div class="bg-gray-900/50 border border-dashed border-gray-800 rounded-2xl p-6 flex items-center justify-center">
      <p
        class="text-gray-600 text-sm text-center"
        data-en="🔜 More projects coming soon"
        data-es="🔜 Más proyectos próximamente"
      >
        🔜 More projects coming soon
      </p>
    </div>
  </section>

  <!-- About -->
  <section class="mt-10 border-t border-gray-800 pt-6 text-center">
    <p
      class="text-gray-600 text-sm max-w-xl mx-auto"
      data-en="Delta-neutral farming and points calculators for the best perp DEXs. Estimates based on public data — not financial advice."
      data-es="Farming delta-neutral y calculadoras de puntos para los mejores perp DEXs. Estimaciones basadas en datos públicos — no es asesoría financiera."
    >
      Delta-neutral farming and points calculators for the best perp DEXs.
    </p>
  </section>
</Layout>
