---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Lyfher — Pointfolio" description="Project your airdrop points across bear, base and bull valuations. Pick the farms you're in, enter your points, see your total in every scenario.">

<!-- Hero -->
<section class="hero-wrap text-center py-8">
  <div class="hero-glow"></div>
  <h1 class="relative text-4xl sm:text-5xl font-bold text-white mb-3">
    Point<span class="text-green-400">folio</span>
  </h1>
  <p class="relative text-gray-400 text-base max-w-2xl mx-auto"
     data-en="Pick the farms you're in, drop in your points, set your bear / base / bull value per point — and see what your whole points stack is worth in every scenario."
     data-es="Elige los farms en los que estás, mete tus puntos, pon tu valor bear / base / bull por punto — y mira cuánto vale todo tu stack de puntos en cada escenario.">
    Project your points across bear / base / bull — pick your farms, enter points, see the total.
  </p>
</section>

<!-- Scenario totals -->
<div class="grid grid-cols-3 gap-3 mb-6">
  <div class="scn scn-bear rounded-2xl p-4 text-center">
    <div class="scn-glow"></div>
    <div class="relative text-xs font-semibold uppercase tracking-widest text-red-300/80" data-en="Bear" data-es="Bear">Bear</div>
    <div id="tot-bear" class="relative text-2xl sm:text-3xl font-bold text-red-300 mt-1">$0</div>
  </div>
  <div class="scn scn-base rounded-2xl p-4 text-center">
    <div class="scn-glow"></div>
    <div class="relative text-xs font-semibold uppercase tracking-widest text-amber-300/80" data-en="Base" data-es="Base">Base</div>
    <div id="tot-base" class="relative text-2xl sm:text-3xl font-bold text-amber-300 mt-1">$0</div>
  </div>
  <div class="scn scn-bull rounded-2xl p-4 text-center">
    <div class="scn-glow"></div>
    <div class="relative text-xs font-semibold uppercase tracking-widest text-green-300/80" data-en="Bull" data-es="Bull">Bull</div>
    <div id="tot-bull" class="relative text-2xl sm:text-3xl font-bold text-green-300 mt-1">$0</div>
  </div>
</div>

<div class="flex items-center justify-between mb-3 gap-3 flex-wrap">
  <p class="text-xs text-gray-500" data-en="Toggle a farm on and enter your points. Grey $/pt = reference (not market data) — type your own to override." data-es="Activa un farm y pon tus puntos. $/pt en gris = referencia (no son datos de mercado) — escribe el tuyo para reemplazarlo.">Grey $/pt = reference — type your own to override.</p>
  <div class="flex items-center gap-3">
    <button id="share" class="text-sm font-semibold px-3.5 py-1.5 rounded-lg border border-green-500/50 text-green-400 bg-green-500/10 hover:bg-green-500/20 transition-colors">
      📸 <span data-en="Share card" data-es="Compartir card">Share card</span>
    </button>
    <button id="reset" class="text-xs text-gray-500 hover:text-amber-400 underline" data-en="reset" data-es="reiniciar">reset</button>
  </div>
</div>

<!-- Share overlay -->
<div id="share-ov" class="hidden fixed inset-0 z-[200] bg-black/70 backdrop-blur-sm flex items-center justify-center p-4" >
  <div class="bg-gray-900 border border-gray-800 rounded-2xl p-4 max-w-2xl w-full" onclick="event.stopPropagation()">
    <div class="flex items-center justify-between mb-3">
      <h3 class="font-bold text-white" data-en="Your Pointfolio card" data-es="Tu card de Pointfolio">Your Pointfolio card</h3>
      <button id="share-close" class="text-gray-500 hover:text-white text-xl leading-none">×</button>
    </div>
    <img id="share-img" class="w-full rounded-xl border border-gray-800" alt="Pointfolio card"/>
    <div class="flex items-center gap-2 mt-3 flex-wrap">
      <button id="dl" class="flex-1 min-w-32 text-center text-sm font-semibold px-3 py-2 rounded-lg bg-green-600 hover:bg-green-500 text-white transition-colors" data-en="⬇ Download PNG" data-es="⬇ Descargar PNG">⬇ Download PNG</button>
      <button id="cp" class="flex-1 min-w-32 text-center text-sm font-semibold px-3 py-2 rounded-lg border border-gray-700 hover:border-green-500 text-gray-200 transition-colors" data-en="⧉ Copy image" data-es="⧉ Copiar imagen">⧉ Copy image</button>
      <a id="tw" target="_blank" rel="noopener noreferrer" class="flex-1 min-w-32 text-center text-sm font-semibold px-3 py-2 rounded-lg border border-sky-500/50 text-sky-400 bg-sky-500/10 hover:bg-sky-500/20 transition-colors" data-en="𝕏 Post on X" data-es="𝕏 Postear en X">𝕏 Post on X</a>
    </div>
    <p id="cp-note" class="text-xs text-gray-500 mt-2 text-center"></p>
  </div>
</div>

<!-- Project cards -->
<div id="cards" class="grid gap-4 sm:grid-cols-2 mb-8"></div>

<section class="mt-2 border-t border-gray-800 pt-6 text-center">
  <p class="text-gray-500 text-sm max-w-xl mx-auto"
     data-en="Values per point are your own assumptions, not predictions — most of these haven't had a TGE. Everything is saved only in your browser. Not financial advice."
     data-es="Los valores por punto son tus propios supuestos, no predicciones — la mayoría aún no tiene TGE. Todo se guarda solo en tu navegador. No es asesoría financiera.">
    Values per point are your own assumptions. Saved only in your browser.
  </p>
</section>

</Layout>

<style is:global>
  .hero-wrap{ position:relative; }
  .hero-glow{
    position:absolute; left:50%; top:30%; width:min(560px,90%); height:220px;
    transform:translate(-50%,-50%); pointer-events:none; z-index:0;
    background: radial-gradient(50% 50% at 50% 50%, rgba(34,197,94,0.18), transparent 70%);
    filter: blur(14px);
  }
  /* scenario summary cards */
  .scn{ position:relative; overflow:hidden; isolation:isolate; border:1px solid #1f2a35; background:#111820;
    transition: transform .18s ease, box-shadow .3s ease; }
  .scn-glow{ position:absolute; inset:-60% auto auto -20%; width:140%; height:160%; z-index:0; pointer-events:none;
    opacity:.5; transition:opacity .3s ease; }
  .scn-bear .scn-glow{ background:radial-gradient(40% 40% at 50% 0%, rgba(248,113,113,.22), transparent 70%); }
  .scn-base .scn-glow{ background:radial-gradient(40% 40% at 50% 0%, rgba(251,191,36,.20), transparent 70%); }
  .scn-bull .scn-glow{ background:radial-gradient(40% 40% at 50% 0%, rgba(74,222,128,.22), transparent 70%); }
  .scn:hover{ transform:translateY(-2px); }
  .scn-bear:hover{ box-shadow:0 14px 40px -16px rgba(248,113,113,.45); }
  .scn-base:hover{ box-shadow:0 14px 40px -16px rgba(251,191,36,.45); }
  .scn-bull:hover{ box-shadow:0 14px 40px -16px rgba(74,222,128,.45); }

  /* project cards */
  .pcard{ position:relative; overflow:hidden; isolation:isolate;
    background: radial-gradient(130% 120% at 100% 0%, color-mix(in srgb, var(--c) 9%, transparent), transparent 55%), #111820;
    border:1px solid #1f2a35; transition: transform .2s ease, border-color .2s ease, box-shadow .3s ease, opacity .2s ease; }
  .pcard::before{ content:""; position:absolute; top:0; left:0; right:0; height:1px; z-index:2;
    background:linear-gradient(90deg, transparent, var(--c), transparent); opacity:.35; transition:opacity .3s ease; }
  .pcard-glow{ position:absolute; inset:-40% 40% auto -40%; height:180%; z-index:0; pointer-events:none;
    background:radial-gradient(40% 40% at 20% 10%, color-mix(in srgb, var(--c) 20%, transparent), transparent 70%);
    opacity:0; transition:opacity .35s ease; }
  .pcard.on{ border-color: color-mix(in srgb, var(--c) 45%, #1f2a35); }
  .pcard.on .pcard-glow{ opacity:.7; }
  .pcard:hover{ transform:translateY(-3px);
    box-shadow:0 0 0 1px color-mix(in srgb,var(--c) 20%,transparent), 0 14px 44px -14px color-mix(in srgb,var(--c) 45%,transparent); }
  .pcard:hover::before{ opacity:.9; }
  .pcard:not(.on){ opacity:.62; }
  .pcard .pdot{ box-shadow:0 0 10px -1px var(--c); }

  .pf-in{ width:100%; background:#0a0e13; border:1px solid #374151; border-radius:8px;
    padding:6px 9px; color:#e5e7eb; font-family:ui-monospace,monospace; font-size:.85rem; outline:none;
    transition:border-color .15s ease; }
  .pf-in:focus{ border-color: color-mix(in srgb, var(--c) 70%, #374151); }
  .pf-in::-webkit-outer-spin-button,.pf-in::-webkit-inner-spin-button{ -webkit-appearance:none; margin:0; }
  .pf-in[type=number]{ -moz-appearance:textfield; }

  /* toggle switch */
  .sw{ width:38px; height:22px; border-radius:999px; background:#374151; position:relative; cursor:pointer;
    transition:background .2s ease; flex:none; }
  .sw::after{ content:""; position:absolute; top:2px; left:2px; width:18px; height:18px; border-radius:50%;
    background:#e5e7eb; transition:transform .2s ease; }
  .pcard.on .sw{ background:var(--c); }
  .pcard.on .sw::after{ transform:translateX(16px); }

  @media (prefers-reduced-motion: reduce){
    .scn,.pcard{ transition:none; } .scn:hover,.pcard:hover{ transform:none; }
  }
</style>

<script is:inline>
const lang = () => document.documentElement.lang || 'en';
const T = (en, es) => lang() === 'es' ? es : en;

// Starting set the user asked for. ref = grey reference $/point (bull=actual, base=mid 50%, bear=25%).
// These are NOT market data — just a reference; each user can type their own over them.
const PROJECTS = [
  { key:'Variational',  color:'#a78bfa', ref:{bear:10,    base:20,   bull:40  } },
  { key:'TxFlow',       color:'#4ade80', ref:{bear:1,     base:3,    bull:8   } },
  { key:'Extended',     color:'#34d399', ref:{bear:0.375, base:0.75, bull:1.5 } },
  { key:'Lighter RH',   color:'#84cc16', ref:{bear:5,     base:10,   bull:20  } },
  { key:'Arcus',        color:'#f472b6', ref:{bear:1,     base:3,    bull:8   } },
  { key:'Pacifica',     color:'#22d3ee', ref:{bear:0.05,  base:0.10, bull:0.20} },
  { key:'RiseX',        color:'#e879f9', ref:{bear:2.5,   base:5,    bull:10  } },
  { key:'Ondo',         color:'#38bdf8', ref:{bear:0.075, base:0.15, bull:0.30} },
];
const DEF = { on:false, pts:'', bear:'', base:'', bull:'' };   // empty = use the grey reference

const KEY='lyfher_pointfolio';
let db={};
try{ const s=localStorage.getItem(KEY); if(s) db=JSON.parse(s)||{}; }catch{}
function stateOf(k){ return Object.assign({}, DEF, db[k]||{}); }
function save(){ try{ localStorage.setItem(KEY, JSON.stringify(db)); }catch{} }

const num = v => { const n=parseFloat(v); return isNaN(n)||n<0 ? 0 : n; };
const money = n => '$'+Math.round(n).toLocaleString('en-US');
function esc(s){return String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));}

function cardHTML(p){
  const s = stateOf(p.key); const r = p.ref||{};
  const ph = v => v==null||v==='' ? '' : String(v);
  return `<div class="pcard rounded-2xl p-4 flex flex-col gap-3 ${s.on?'on':''}" style="--c:${p.color}" data-k="${esc(p.key)}">
    <div class="pcard-glow"></div>
    <div class="relative flex items-center justify-between gap-2">
      <div class="flex items-center gap-2 min-w-0">
        <span class="pdot w-3 h-3 rounded-full shrink-0" style="background:${p.color}"></span>
        <span class="font-bold text-white text-base truncate">${esc(p.key)}</span>
      </div>
      <div class="sw" role="switch" aria-checked="${s.on}" data-act="toggle"></div>
    </div>
    <div class="relative">
      <label class="block text-[11px] text-gray-500 mb-1">${T('My points','Mis puntos')}</label>
      <input class="pf-in" type="number" min="0" step="any" inputmode="decimal" placeholder="0" value="${esc(s.pts)}" data-f="pts" />
    </div>
    <div class="relative grid grid-cols-3 gap-2">
      <div>
        <label class="block text-[11px] text-red-300/70 mb-1">${T('Bear $/pt','Bear $/pt')}</label>
        <input class="pf-in" type="number" min="0" step="any" inputmode="decimal" placeholder="${ph(r.bear)}" value="${esc(s.bear)}" data-f="bear" />
      </div>
      <div>
        <label class="block text-[11px] text-amber-300/70 mb-1">${T('Base $/pt','Base $/pt')}</label>
        <input class="pf-in" type="number" min="0" step="any" inputmode="decimal" placeholder="${ph(r.base)}" value="${esc(s.base)}" data-f="base" />
      </div>
      <div>
        <label class="block text-[11px] text-green-300/70 mb-1">${T('Bull $/pt','Bull $/pt')}</label>
        <input class="pf-in" type="number" min="0" step="any" inputmode="decimal" placeholder="${ph(r.bull)}" value="${esc(s.bull)}" data-f="bull" />
      </div>
    </div>
    <div class="relative pt-1 flex items-center justify-between text-xs border-t border-gray-800/70 mt-1">
      <span class="text-gray-500 mt-2">${T('Value','Valor')}</span>
      <span class="pval mt-2 font-mono text-gray-300"></span>
    </div>
  </div>`;
}

// effective $/pt for a field: the user's typed value, else the grey reference
function eff(p, s, field){ const u=s[field]; if(u!=='' && u!=null) return num(u); return num((p.ref||{})[field]); }
function rowValue(p, s){
  const pts=num(s.pts);
  return { bear:pts*eff(p,s,'bear'), base:pts*eff(p,s,'base'), bull:pts*eff(p,s,'bull') };
}
function recompute(){
  let tb=0,tm=0,tu=0;
  PROJECTS.forEach(p=>{
    const s=stateOf(p.key); const card=document.querySelector(`.pcard[data-k="${CSS.escape(p.key)}"]`);
    const v=rowValue(p, s);
    if(s.on){ tb+=v.bear; tm+=v.base; tu+=v.bull; }
    if(card){ const el=card.querySelector('.pval');
      el.textContent = s.on && num(s.pts)>0 ? `${money(v.bear)} · ${money(v.base)} · ${money(v.bull)}` : '—';
      el.className = `pval mt-2 font-mono ${s.on&&num(s.pts)>0?'text-gray-300':'text-gray-600'}`; }
  });
  document.getElementById('tot-bear').textContent = money(tb);
  document.getElementById('tot-base').textContent = money(tm);
  document.getElementById('tot-bull').textContent = money(tu);
}

function render(){
  document.getElementById('cards').innerHTML = PROJECTS.map(cardHTML).join('');
  recompute();
}

document.getElementById('cards').addEventListener('click', e=>{
  const sw = e.target.closest('[data-act="toggle"]'); if(!sw) return;
  const card = sw.closest('.pcard'); const k = card.dataset.k;
  const s = stateOf(k); s.on=!s.on; db[k]=s;
  card.classList.toggle('on', s.on); sw.setAttribute('aria-checked', s.on);
  save(); recompute();
});
document.getElementById('cards').addEventListener('input', e=>{
  const inp = e.target.closest('.pf-in'); if(!inp) return;
  const card = inp.closest('.pcard'); const k = card.dataset.k; const f = inp.dataset.f;
  const s = stateOf(k); s[f]=inp.value; db[k]=s;
  save(); recompute();
});
document.getElementById('reset').addEventListener('click', ()=>{
  db={}; try{ localStorage.removeItem(KEY); }catch{}
  render();
});

const _setLang = window.setLang;
window.setLang = l => { if(_setLang) _setLang(l); render(); };

render();

// ─── Share card (canvas, no external libs) ───────────────────────────────
function enabledRows(){
  return PROJECTS.map(p=>{ const s=stateOf(p.key); return {p, s, v:rowValue(p, s)}; })
                 .filter(x=>x.s.on && num(x.s.pts)>0);
}
function fmtPts(n){ return num(n).toLocaleString('en-US',{maximumFractionDigits:2}); }
function rr(ctx,x,y,w,h,r){ ctx.beginPath(); ctx.roundRect(x,y,w,h,r); }

function drawCard(){
  const W=1200,H=675,S=2;
  const cv=document.createElement('canvas'); cv.width=W*S; cv.height=H*S;
  const ctx=cv.getContext('2d'); ctx.scale(S,S);
  ctx.textBaseline='alphabetic';

  // background + top glow
  ctx.fillStyle='#0a0e13'; ctx.fillRect(0,0,W,H);
  let g=ctx.createRadialGradient(W/2,-60,40,W/2,-60,760);
  g.addColorStop(0,'rgba(34,197,94,0.16)'); g.addColorStop(1,'rgba(10,14,19,0)');
  ctx.fillStyle=g; ctx.fillRect(0,0,W,H);
  ctx.strokeStyle='#1f2a35'; ctx.lineWidth=2; ctx.strokeRect(1,1,W-2,H-2);

  // header
  ctx.fillStyle='#e8eef4'; ctx.font='700 30px system-ui,-apple-system,sans-serif';
  ctx.fillText('⚡ Lyfher', 56, 72);
  ctx.textAlign='right'; ctx.fillStyle='#8a99a8'; ctx.font='500 22px system-ui,sans-serif';
  ctx.fillText('@LyfherCrypto', W-56, 70); ctx.textAlign='left';

  // title
  ctx.fillStyle='#e8eef4'; ctx.font='800 56px system-ui,sans-serif';
  ctx.fillText('Pointfolio', 56, 150);
  ctx.fillStyle='#8a99a8'; ctx.font='500 22px system-ui,sans-serif';
  ctx.fillText(T('Projected value of my points','Valor proyectado de mis puntos'), 58, 184);

  // totals
  const rows=enabledRows();
  let tb=0,tm=0,tu=0; rows.forEach(r=>{tb+=r.v.bear;tm+=r.v.base;tu+=r.v.bull;});
  const scn=[[T('BEAR','BEAR'),tb,'#f87171'],[T('BASE','BASE'),tm,'#fbbf24'],[T('BULL','BULL'),tu,'#4ade80']];
  const gap=18, cardW=(W-112-2*gap)/3, cy=210, ch=118;
  scn.forEach((s,i)=>{ const cx=56+i*(cardW+gap);
    rr(ctx,cx,cy,cardW,ch,16); ctx.fillStyle='#111820'; ctx.fill();
    ctx.save(); rr(ctx,cx,cy,cardW,ch,16); ctx.clip();
    const gg=ctx.createRadialGradient(cx+cardW/2,cy,10,cx+cardW/2,cy,cardW);
    gg.addColorStop(0,s[2]+'22'); gg.addColorStop(1,'rgba(0,0,0,0)'); ctx.fillStyle=gg; ctx.fillRect(cx,cy,cardW,ch);
    ctx.restore();
    rr(ctx,cx,cy,cardW,ch,16); ctx.strokeStyle=s[2]+'44'; ctx.lineWidth=1.5; ctx.stroke();
    ctx.fillStyle=s[2]; ctx.font='700 18px system-ui,sans-serif'; ctx.fillText(s[0], cx+22, cy+40);
    ctx.font='800 42px system-ui,sans-serif'; ctx.fillText(money(s[1]), cx+22, cy+92);
  });

  // project breakdown (two columns, up to 8)
  ctx.fillStyle='#5b6b7a'; ctx.font='600 15px system-ui,sans-serif';
  ctx.fillText(T('BREAKDOWN · points × base','DESGLOSE · puntos × base').toUpperCase(), 56, 378);
  const n=rows.length, perCol=Math.ceil(n/2)||1, colGap=18, colW=(W-112-colGap)/2, y0=406, rh=52;
  rows.forEach((r,i)=>{ const col=i<perCol?0:1, row=col===0?i:i-perCol;
    const x=56+col*(colW+colGap), y=y0+row*rh;
    rr(ctx,x,y,colW,rh-10,12); ctx.fillStyle='#0e141b'; ctx.fill();
    ctx.beginPath(); ctx.arc(x+22,y+(rh-10)/2,6,0,7); ctx.fillStyle=r.p.color; ctx.fill();
    ctx.fillStyle='#e8eef4'; ctx.font='700 21px system-ui,sans-serif'; ctx.textAlign='left';
    ctx.fillText(r.p.key, x+40, y+28);
    ctx.textAlign='right'; ctx.fillStyle='#8a99a8'; ctx.font='500 16px system-ui,sans-serif';
    ctx.fillText(fmtPts(r.s.pts)+' pts', x+colW-115, y+27);
    ctx.fillStyle='#fbbf24'; ctx.font='700 19px system-ui,sans-serif';
    ctx.fillText(money(r.v.base), x+colW-16, y+27); ctx.textAlign='left';
  });
  if(!n){ ctx.fillStyle='#5b6b7a'; ctx.font='500 20px system-ui,sans-serif';
    ctx.fillText(T('No farms selected yet.','Aún no hay farms seleccionados.'), 56, 440); }

  // footer
  ctx.strokeStyle='#1f2a35'; ctx.lineWidth=1; ctx.beginPath(); ctx.moveTo(56,H-58); ctx.lineTo(W-56,H-58); ctx.stroke();
  ctx.fillStyle='#22c55e'; ctx.font='700 22px system-ui,sans-serif'; ctx.fillText('lyfher.xyz/pointfolio', 56, H-26);
  ctx.textAlign='right'; ctx.fillStyle='#5b6b7a'; ctx.font='500 18px system-ui,sans-serif';
  ctx.fillText(T('Project your points →','Proyecta tus puntos →'), W-56, H-26); ctx.textAlign='left';

  return cv;
}

let _blob=null;
function openShare(){
  const rows=enabledRows();
  if(!rows.length){ alert(T('Toggle at least one farm and enter your points first.','Activa al menos un farm y pon tus puntos primero.')); return; }
  const cv=drawCard();
  document.getElementById('share-img').src=cv.toDataURL('image/png');
  cv.toBlob(b=>{ _blob=b; }, 'image/png');
  const txt=encodeURIComponent(T('My points stack, projected bear / base / bull 📊\n\nlyfher.xyz/pointfolio','Mi stack de puntos, proyectado bear / base / bull 📊\n\nlyfher.xyz/pointfolio'));
  document.getElementById('tw').href='https://twitter.com/intent/tweet?text='+txt;
  document.getElementById('cp-note').textContent='';
  document.getElementById('share-ov').classList.remove('hidden');
}
function closeShare(){ document.getElementById('share-ov').classList.add('hidden'); }

document.getElementById('share').addEventListener('click', openShare);
document.getElementById('share-close').addEventListener('click', closeShare);
document.getElementById('share-ov').addEventListener('click', closeShare);
document.getElementById('dl').addEventListener('click', ()=>{
  const go=b=>{ const u=URL.createObjectURL(b); const a=document.createElement('a');
    a.href=u; a.download='lyfher-pointfolio.png'; a.click(); setTimeout(()=>URL.revokeObjectURL(u),1000); };
  if(_blob) go(_blob); else drawCard().toBlob(go,'image/png');
});
document.getElementById('cp').addEventListener('click', async ()=>{
  const note=document.getElementById('cp-note');
  try{
    const blob=_blob||await new Promise(res=>drawCard().toBlob(res,'image/png'));
    await navigator.clipboard.write([new ClipboardItem({'image/png':blob})]);
    note.textContent=T('Copied — paste it into your X post.','Copiada — pégala en tu post de X.'); note.className='text-xs text-green-400 mt-2 text-center';
  }catch(e){ note.textContent=T('Copy not supported here — use Download instead.','Copiar no soportado aquí — usa Descargar.'); note.className='text-xs text-amber-400 mt-2 text-center'; }
});
</script>
